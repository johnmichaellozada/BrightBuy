
{% extends 'base.html.twig' %}

{% block title %}Products | BrightBuy Admin{% endblock %}

{% block body %}

<style>
    .products-container {
        position: relative;
        isolation: isolate;
        width: 100%;
        max-width: 1350px;
        margin: auto;
        padding: 42px 30px 60px;
    }

    .products-container::before,
    .products-container::after {
        content: "";
        position: absolute;
        z-index: -1;
        pointer-events: none;
        border-radius: 50%;
    }

    .products-container::before {
        width: 300px;
        height: 300px;
        top: 35px;
        right: -110px;
        border: 28px solid rgba(25, 112, 220, .07);
    }

    .products-container::after {
        width: 230px;
        height: 230px;
        bottom: -100px;
        left: -65px;
        border: 24px solid rgba(255, 191, 0, .08);
    }

    .products-heading { margin-bottom: 30px; }

    .products-heading h1 {
        display: flex;
        align-items: center;
        gap: 11px;
        color: #071b55;
        font-size: 34px;
        font-weight: 800;
        letter-spacing: -.6px;
        margin: 0;
    }

    .products-heading h1::before {
        content: "";
        width: 7px;
        height: 34px;
        flex: 0 0 7px;
        border-radius: 8px;
        background: #ffbf00;
    }

    .products-heading p {
        color: #71809b;
        font-size: 14px;
        margin-top: 8px;
    }

    .products-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .products-stat-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 25px;
        background: rgba(255,255,255,.97);
        border: 1px solid rgba(255,255,255,.9);
        border-radius: 20px;
        box-shadow: 0 10px 26px rgba(8,44,105,.10);
        transition: transform .2s ease, box-shadow .2s ease;
        overflow: hidden;
    }

    .products-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 30px rgba(8,44,105,.14);
    }

    .products-stat-card::after {
        content: "";
        position: absolute;
        right: 0;
        bottom: 0;
        width: 58px;
        height: 19px;
        background: #ffbf00;
        clip-path: polygon(100% 0, 100% 100%, 0 100%);
    }

    .products-stat-icon {
        width: 58px;
        height: 58px;
        min-width: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        font-size: 25px;
    }

    .products-stat-icon.total { background: #e6ecfa; color: #1264e8; }
    .products-stat-icon.low { background: #fff1cc; color: #d18b00; }
    .products-stat-icon.out { background: #ffe1e1; color: #dc3545; }

    .products-stat-card h2 {
        color: #06185f;
        font-size: 30px;
        font-weight: 800;
        margin: 0;
    }

    .products-stat-card p {
        color: #71809b;
        font-size: 13px;
        margin: 4px 0 0;
    }

    .products-alert {
        border-radius: 12px;
        font-size: 13px;
        margin-bottom: 20px;
    }

    .products-panel {
        background: rgba(255,255,255,.98);
        border: 1px solid rgba(255,255,255,.9);
        border-radius: 22px;
        box-shadow: 0 10px 26px rgba(8,44,105,.10);
        overflow: hidden;
    }

    .products-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px 28px;
        border-bottom: 1px solid #edf0f5;
        gap: 15px;
        flex-wrap: wrap;
    }

    .products-panel-header h2 {
        color: #071b55;
        font-size: 22px;
        font-weight: 800;
        margin: 0;
    }

    .products-panel-header h2 i { color: #1264e8; }

    .products-panel-header p {
        color: #71809b;
        font-size: 13px;
        margin: 6px 0 0;
    }

    .products-eyebrow {
        display: inline-block;
        color: #1264e8;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        margin-bottom: 7px;
    }

    .products-count {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        background: #e6ecfa;
        color: #1264e8;
        font-size: 11px;
        font-weight: 700;
        margin-left: 8px;
    }

    .products-add-btn {
        padding: 10px 17px;
        border: 1px solid #ffbf00;
        border-radius: 9px;
        background: #ffbf00;
        color: #06185f;
        font-size: 13px;
        font-weight: 700;
    }

    .products-add-btn:hover {
        background: #e6aa00;
        border-color: #e6aa00;
        color: #06185f;
    }

    .products-filters {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 15px;
        padding: 22px 28px;
        background: #f6f9ff;
        border-bottom: 1px solid #e6edf8;
    }

    .products-filters label {
        display: block;
        color: #526b91;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .products-filters input,
    .products-filters select {
        width: 100%;
        min-height: 43px;
        padding: 10px 13px;
        border: 1px solid #dce3ef;
        border-radius: 10px;
        outline: none;
        font-family: inherit;
        font-size: 13px;
        color: #334155;
        background: #ffffff;
    }

    .products-filters input:focus,
    .products-filters select:focus {
        border-color: #1264e8;
        box-shadow: 0 0 0 3px rgba(18,100,232,.10);
    }

    .products-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .products-table {
        width: 100%;
        min-width: 1000px;
        border-collapse: collapse;
        margin: 0;
    }

    .products-table thead { background: #edf3ff; }

    .products-table th {
        padding: 16px 18px;
        text-align: left;
        color: #526b91;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
    }

    .products-table td {
        padding: 15px 18px;
        border-bottom: 1px solid #edf0f5;
        color: #263f6d;
        font-size: 13px;
        vertical-align: middle;
    }

    .products-table tbody tr { transition: background .18s ease; }
    .products-table tbody tr:hover { background: #f1f6ff; }

    .product-info {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 200px;
    }

    .product-image {
        width: 55px;
        height: 55px;
        min-width: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 1px solid #e6edf8;
        border-radius: 12px;
        background: #f6f9ff;
    }

    .product-image img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .product-image-placeholder {
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
        color: #a5b1c3;
        font-size: 23px;
    }

    .product-name {
        color: #06185f;
        font-size: 13px;
        font-weight: 700;
    }

    .product-id {
        color: #8a96a9;
        font-size: 11px;
        margin-top: 4px;
    }

    .product-category {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        background: #e6ecfa;
        color: #2458b5;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .product-price {
        color: #06185f;
        font-weight: 700;
        white-space: nowrap;
    }

    .product-stock {
        color: #06185f;
        font-size: 14px;
        font-weight: 800;
    }

    .product-stock-note {
        display: block;
        font-size: 11px;
        margin-top: 4px;
    }

    .product-stock-note.low { color: #b77900; }
    .product-stock-note.out { color: #dc3545; }

    .product-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .product-status.in-stock { background: #d9f7e8; color: #198754; }
    .product-status.low-stock { background: #fff1cc; color: #936500; }
    .product-status.out-of-stock { background: #ffe1e1; color: #dc3545; }

    .product-actions {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: 7px;
        white-space: nowrap;
    }

    .product-actions .btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
    }

    .products-empty {
        padding: 60px 20px !important;
        text-align: center;
        color: #71809b !important;
    }

    .products-empty i {
        display: block;
        color: #a5b1c3;
        font-size: 43px;
        margin-bottom: 12px;
    }

    .products-empty h3 {
        color: #06185f;
        font-size: 18px;
        font-weight: 800;
    }

    .products-empty p {
        color: #71809b;
        font-size: 13px;
    }

    .products-no-results {
        display: none;
        padding: 25px 20px;
        text-align: center;
        color: #71809b;
        font-size: 13px;
    }

    .products-footer {
        padding: 18px 28px;
        color: #526b91;
        font-size: 12px;
        font-weight: 500;
        background: #f6f9ff;
        border-top: 1px solid #e6edf8;
    }

    @media (max-width: 900px) {
        .products-stats { grid-template-columns: repeat(2, 1fr); }
        .products-filters { grid-template-columns: 1fr 1fr; }
        .products-filters > div:first-child { grid-column: 1 / -1; }
    }

    @media (max-width: 600px) {
        .products-container { padding: 28px 15px 40px; }
        .products-heading h1 { font-size: 27px; }
        .products-stats { grid-template-columns: 1fr; }
        .products-filters { grid-template-columns: 1fr; }
        .products-filters > div:first-child { grid-column: auto; }
        .products-panel-header { padding: 20px; }
    }
</style>

<div class="products-container">

    <div class="products-heading">
        <h1>Products</h1>
        <p>Manage your BrightBuy products, inventory, and product information.</p>
    </div>

    {# Product Summary Cards #}
    <div class="products-stats">

        <div class="products-stat-card">
            <div class="products-stat-icon total">
                <i class="bi bi-box-seam-fill"></i>
            </div>
            <div>
                <h2>{{ products|length }}</h2>
                <p>Total Products</p>
            </div>
        </div>

        <div class="products-stat-card">
            <div class="products-stat-icon low">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div>
                <h2>{{ lowStockCount|default(0) }}</h2>
                <p>Low Stock Products</p>
            </div>
        </div>

        <div class="products-stat-card">
            <div class="products-stat-icon out">
                <i class="bi bi-box2-fill"></i>
            </div>
            <div>
                <h2>{{ outOfStockCount|default(0) }}</h2>
                <p>Out of Stock Products</p>
            </div>
        </div>

    </div>

    {# Inventory Alerts #}
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="alert alert-warning products-alert h-100 mb-0">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                    <div>
                        <div class="fw-semibold">Low Stock Alert</div>
                        <div>
                            <strong>{{ lowStockCount|default(0) }}</strong>
                            product(s) have {{ lowStockThreshold|default(5) }} units or fewer,
                            excluding out-of-stock products.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="alert alert-danger products-alert h-100 mb-0">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-x-circle-fill fs-3"></i>
                    <div>
                        <div class="fw-semibold">Out of Stock</div>
                        <div>
                            <strong>{{ outOfStockCount|default(0) }}</strong>
                            product(s) currently have no available stock.
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    {# Flash Messages #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show products-alert" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger alert-dismissible fade show products-alert" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {# Products Main Panel #}
    <section class="products-panel">

        <div class="products-panel-header">
            <div>
                <span class="products-eyebrow">STORE INVENTORY</span>
                <div class="d-flex align-items-center flex-wrap">
                    <h2>
                        <i class="bi bi-box-seam-fill me-2"></i>
                        Product List
                    </h2>
                    <span class="products-count">
                        {{ products|length }} Products
                    </span>
                </div>
                <p>View all products and manage products assigned to your account.</p>
            </div>

            <a href="{{ path('app_product_new') }}" class="btn products-add-btn">
                <i class="bi bi-plus-lg me-1"></i>
                Add Product
            </a>
        </div>

        {# Search and Filters #}
        <div class="products-filters">

            <div>
                <label for="productSearch">
                    <i class="bi bi-search me-1"></i>
                    Search Products
                </label>
                <input
                    type="search"
                    id="productSearch"
                    placeholder="Search products..."
                    aria-label="Search products"
                >
            </div>

            <div>
                <label for="categoryFilter">
                    <i class="bi bi-tags me-1"></i>
                    Filter by Category
                </label>
                <select id="categoryFilter" aria-label="Filter by category">
                    <option value="all">All Categories</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}">{{ category.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label for="stockFilter">
                    <i class="bi bi-funnel me-1"></i>
                    Filter by Stock Status
                </label>
                <select id="stockFilter" aria-label="Filter by stock status">
                    <option value="all">All Stock Status</option>
                    <option value="in-stock">In Stock</option>
                    <option value="low-stock">Low Stock</option>
                    <option value="out-of-stock">Out of Stock</option>
                </select>
            </div>

        </div>

        {# Products Table #}
        <div class="products-table-wrapper">

            <table class="products-table">

                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody id="productTableBody">

                {% for product in products %}

                    {% set currentStock = product.stock|default(0) %}
                    {% set threshold = lowStockThreshold|default(5) %}
                    {% set isProductOwner = product.createdBy and app.user and product.createdBy.id == app.user.id %}
                    {% set canManageProduct = is_granted('ROLE_ADMIN') or (is_granted('ROLE_STAFF') and isProductOwner) %}

                    {% set stockStatus =
                        currentStock <= 0
                            ? 'out-of-stock'
                            : (currentStock <= threshold ? 'low-stock' : 'in-stock')
                    %}

                    <tr
                        data-stock-status="{{ stockStatus }}"
                        data-category-id="{{ product.category ? product.category.id : '' }}"
                    >

                        <td>
                            <div class="product-info">

                                <div class="product-image">

                                    {% if product.image %}
                                        <img
                                            src="{{ asset(product.image) }}"
                                            alt="{{ product.name }}"
                                            loading="lazy"
                                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                        >

                                        <div class="product-image-placeholder" style="display:none;">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    {% else %}
                                        <div class="product-image-placeholder">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    {% endif %}

                                </div>

                                <div>
                                    <div class="product-name">{{ product.name }}</div>
                                    <div class="product-id">
                                        Product #{{ '%03d'|format(product.id) }}
                                    </div>
                                </div>

                            </div>
                        </td>

                        <td>
                            {% if product.category %}
                                <span class="product-category">
                                    {{ product.category.name }}
                                </span>
                            {% else %}
                                <span class="text-muted">Not assigned</span>
                            {% endif %}
                        </td>

                        <td>
                            <span class="product-price">
                                ₱{{ product.price|number_format(2, '.', ',') }}
                            </span>
                        </td>

                        <td>
                            <span class="product-stock">{{ currentStock }}</span>

                            {% if currentStock <= 0 %}
                                <span class="product-stock-note out">Restock needed</span>
                            {% elseif currentStock <= threshold %}
                                <span class="product-stock-note low">Running low</span>
                            {% endif %}
                        </td>

                        <td>
                            {% if currentStock <= 0 %}
                                <span class="product-status out-of-stock">
                                    <i class="bi bi-x-circle-fill"></i>
                                    Out of Stock
                                </span>
                            {% elseif currentStock <= threshold %}
                                <span class="product-status low-stock">
                                    <i class="bi bi-exclamation-circle-fill"></i>
                                    Low Stock
                                </span>
                            {% else %}
                                <span class="product-status in-stock">
                                    <i class="bi bi-check-circle-fill"></i>
                                    In Stock
                                </span>
                            {% endif %}
                        </td>

                        <td class="text-end">
                            <div class="product-actions">

                                {# View is available for every product #}
                                <a
                                    href="{{ path('app_product_show', {'id': product.id}) }}"
                                    class="btn btn-sm btn-outline-info"
                                    title="View product"
                                    aria-label="View {{ product.name }}"
                                >
                                    <i class="bi bi-eye"></i>
                                </a>

                                {# Management actions only for Admin or product owner #}
                                {% if canManageProduct %}

                                    <a
                                        href="{{ path('app_product_inventory', {'id': product.id}) }}"
                                        class="btn btn-sm btn-outline-success"
                                        title="Adjust stock"
                                        aria-label="Adjust stock for {{ product.name }}"
                                    >
                                        <i class="bi bi-box-seam"></i>
                                    </a>

                                    <a
                                        href="{{ path('app_product_edit', {'id': product.id}) }}"
                                        class="btn btn-sm btn-outline-primary"
                                        title="Edit product"
                                        aria-label="Edit {{ product.name }}"
                                    >
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    {{ include('product/_delete_form.html.twig') }}

                                {% endif %}

                            </div>
                        </td>

                    </tr>

                {% else %}

                    <tr id="emptyProductsRow">
                        <td colspan="6" class="products-empty">
                            <i class="bi bi-box-seam"></i>
                            <h3>No Products Found</h3>
                            <p class="mb-0">
                                Add your first product to start managing inventory.
                            </p>
                        </td>
                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

        {# No Filter Results #}
        <div id="noFilterResults" class="products-no-results">
            <i class="bi bi-search fs-3"></i>
            <p class="mb-0 mt-2">No products match your filters.</p>
        </div>

        <div class="products-footer">
            <i class="bi bi-info-circle me-1"></i>
            Low-stock threshold: {{ lowStockThreshold|default(5) }} units
            <span class="mx-2">|</span>
            Total products: {{ products|length }}
        </div>

    </section>

</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
    document.addEventListener('DOMContentLoaded', function () {

        const searchInput = document.getElementById('productSearch');
        const categoryFilter = document.getElementById('categoryFilter');
        const stockFilter = document.getElementById('stockFilter');
        const tableBody = document.getElementById('productTableBody');
        const noResults = document.getElementById('noFilterResults');

        if (!searchInput || !categoryFilter || !stockFilter || !tableBody) {
            return;
        }

        function filterProducts() {

            const query = searchInput.value.toLowerCase().trim();
            const selectedCategory = categoryFilter.value;
            const selectedStock = stockFilter.value;

            const rows = tableBody.querySelectorAll('tr[data-stock-status]');

            let visibleCount = 0;

            rows.forEach(function (row) {

                const matchesSearch =
                    row.textContent.toLowerCase().includes(query);

                const matchesCategory =
                    selectedCategory === 'all' ||
                    row.dataset.categoryId === selectedCategory;

                const matchesStock =
                    selectedStock === 'all' ||
                    row.dataset.stockStatus === selectedStock;

                const showRow =
                    matchesSearch && matchesCategory && matchesStock;

                row.style.display = showRow ? '' : 'none';

                if (showRow) {
                    visibleCount++;
                }

            });

            if (noResults) {
                noResults.style.display =
                    rows.length > 0 && visibleCount === 0 ? 'block' : 'none';
            }

        }

        searchInput.addEventListener('input', filterProducts);
        categoryFilter.addEventListener('change', filterProducts);
        stockFilter.addEventListener('change', filterProducts);

    });
    </script>
{% endblock %}
