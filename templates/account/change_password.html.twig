
{% extends 'base.html.twig' %}

{% block title %}Change Password | BrightBuy{% endblock %}

{% block body %}

<div class="dashboard-container">

    <section class="welcome-section">
        <span class="dashboard-eyebrow">ACCOUNT SECURITY</span>
        <h1>Change Password</h1>
        <p>Keep your BrightBuy administrator account secure by updating your password.</p>
    </section>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white border-0 px-4 pt-4">
                    <h4 class="fw-bold mb-1">
                        <i class="bi bi-shield-lock text-primary me-2"></i>
                        Update Your Password
                    </h4>
                    <p class="text-muted small mb-0">
                        Enter your current password and choose a new one.
                    </p>
                </div>

                <div class="card-body p-4">

                    {{ form_start(form) }}

                    <div class="mb-4">
                        {{ form_label(form.currentPassword) }}
                        {{ form_widget(form.currentPassword, {
                            attr: {
                                class: 'form-control password-field',
                                autocomplete: 'current-password'
                            }
                        }) }}
                        <div class="text-danger small mt-1">
                            {{ form_errors(form.currentPassword) }}
                        </div>
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.plainPassword.first) }}
                        {{ form_widget(form.plainPassword.first, {
                            attr: {
                                class: 'form-control password-field',
                                autocomplete: 'new-password'
                            }
                        }) }}
                        <div class="text-danger small mt-1">
                            {{ form_errors(form.plainPassword.first) }}
                        </div>
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.plainPassword.second) }}
                        {{ form_widget(form.plainPassword.second, {
                            attr: {
                                class: 'form-control password-field',
                                autocomplete: 'new-password'
                            }
                        }) }}
                        <div class="text-danger small mt-1">
                            {{ form_errors(form.plainPassword.second) }}
                        </div>
                    </div>

                    <div class="password-requirement mb-4">
                        <i class="bi bi-info-circle text-primary me-2"></i>
                        Your new password must contain at least 8 characters.
                    </div>

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle me-2"></i>
                            Update Password
                        </button>

                        <a href="{{ path('app_account_profile') }}"
                           class="btn btn-light border px-4">
                            Cancel
                        </a>

                    </div>

                    {{ form_end(form) }}

                </div>
            </div>

        </div>
    </div>

</div>

<style>
    .password-field {
        min-height: 46px;
        border-radius: 9px;
        padding: 10px 13px;
    }

    .password-field:focus {
        border-color: #1264e8;
        box-shadow: 0 0 0 0.2rem rgba(18, 100, 232, 0.12);
    }

    .password-requirement {
        padding: 12px 14px;
        background: #f1f6ff;
        border-radius: 9px;
        color: #42536b;
        font-size: 13px;
    }
</style>

{% endblock %}
