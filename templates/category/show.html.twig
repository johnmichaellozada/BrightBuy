
{% extends 'admin/base.html.twig' %}

{% block title %}Category Details | BrightBuy Admin{% endblock %}

{% block body %}
<div class="dashboard-container">

    <section class="welcome-section">
        <span class="dashboard-eyebrow">PRODUCT MANAGEMENT</span>
        <h1>Category Details</h1>
        <p>View the information for this BrightBuy product category.</p>
    </section>

    <section class="customers-card">

        <div class="customers-header">
            <div>
                <span class="section-eyebrow">STORE ORGANIZATION</span>
                <h4>
                    <i class="bi bi-tags-fill"></i>
                    {{ category.name }}
                </h4>
            </div>

            <span class="badge text-bg-primary">
                Category #{{ category.id }}
            </span>
        </div>

        <div class="p-4">

            <div class="mb-4">
                <label class="form-label fw-semibold text-muted">
                    Category ID
                </label>
                <div class="p-3 bg-light rounded border">
                    {{ category.id }}
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-muted">
                    Category Name
                </label>
                <div class="p-3 bg-light rounded border">
                    {{ category.name }}
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-muted">
                    Description
                </label>
                <div class="p-3 bg-light rounded border"
                     style="min-height: 100px; white-space: pre-wrap;">{{ category.description ?: 'No description provided.' }}</div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">

                <a href="{{ path('app_category_index') }}"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Categories
                </a>

                <a href="{{ path('app_category_edit', {'id': category.id}) }}"
                   class="btn btn-warning fw-semibold">
                    <i class="bi bi-pencil-square me-1"></i>
                    Edit Category
                </a>

            </div>

        </div>

    </section>
</div>
{% endblock %}
