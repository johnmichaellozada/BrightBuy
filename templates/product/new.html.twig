
{% extends 'base.html.twig' %}

{% block title %}Add Product | BrightBuy Admin{% endblock %}

{% block body %}
<div class="dashboard-container">

    <section class="welcome-section">
        <span class="dashboard-eyebrow">PRODUCT MANAGEMENT</span>
        <h1>Add Product</h1>
        <p>Create a new product for your BrightBuy inventory.</p>
    </section>

    <section class="customers-card">

        <div class="customers-header">
            <div>
                <span class="section-eyebrow">STORE INVENTORY</span>
                <h4>
                    <i class="bi bi-box-seam-fill text-warning"></i>
                    Product Information
                </h4>
            </div>
        </div>

        <div class="p-4">
            {{ include('product/_form.html.twig', {
                'button_label': 'Save Product'
            }) }}

            <div class="mt-4">
                <a href="{{ path('app_product_index') }}"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Back to Products
                </a>
            </div>
        </div>

    </section>
</div>
{% endblock %}

