
{% extends 'base.html.twig' %}

{% block title %}Products | BrightBuy Admin{% endblock %}

{% block body %}

<div class="dashboard-container">

    <section class="welcome-section">
        <span class="dashboard-eyebrow">PRODUCT MANAGEMENT</span>
        <h1>Products</h1>
        <p>Manage your BrightBuy products, inventory, and product information.</p>
    </section>

    <section class="customers-card">

        <div class="customers-header">
            <div>
                <span class="section-eyebrow">STORE INVENTORY</span>
                <h4>
                    <i class="bi bi-box-seam-fill"></i>
                    Product List
                </h4>
            </div>

            <a href="{{ path('app_product_new') }}" class="btn btn-warning">
                <i class="bi bi-plus-lg"></i>
                Add Product
            </a>
        </div>

        <div class="p-4 border-bottom">
            <div class="row g-3">

                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input
                            type="search"
                            id="productSearch"
                            class="form-control"
                            placeholder="Search products..."
                        >
                    </div>
                </div>

                <div class="col-md-3">
                    <select id="categoryFilter" class="form-select">
                        <option value="all">All Categories</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}">
                                {{ category.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-3">
                    <select id="stockFilter" class="form-select">
                        <option value="all">All Stock Status</option>
                        <option value="in-stock">In Stock</option>
                        <option value="low-stock">Low Stock</option>
                        <option value="out-of-stock">Out of Stock</option>
                    </select>
                </div>

            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody id="productTableBody">
                {% for product in products %}
                    {% set stockStatus =
                        product.stock <= 0
                            ? 'out-of-stock'
                            : (product.stock <= 5 ? 'low-stock' : 'in-stock')
                    %}

                    <tr
                        data-stock-status="{{ stockStatus }}"
                        data-category-id="{{ product.category ? product.category.id : '' }}"
                    >
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div
                                    class="bg-light rounded d-flex align-items-center justify-content-center flex-shrink-0"
                                    style="width: 55px; height: 55px;"
                                >
                                    <i class="bi bi-image text-secondary fs-4"></i>
                                </div>

                                <div>
                                    <strong>{{ product.name }}</strong>
                                    <div class="text-muted small">
                                        Product #{{ '%03d'|format(product.id) }}
                                    </div>
                                </div>
                            </div>
                        </td>

                        <td>
                            {% if product.category %}
                                <span class="badge bg-light text-dark border">
                                    {{ product.category.name }}
                                </span>
                            {% else %}
                                <span class="text-muted">Not assigned</span>
                            {% endif %}
                        </td>

                        <td class="text-nowrap">
                            ₱{{ product.price|number_format(2, '.', ',') }}
                        </td>

                        <td>{{ product.stock }}</td>

                        <td>
                            {% if product.stock <= 0 %}
                                <span class="badge bg-secondary">No Stock</span>
                            {% elseif product.stock <= 5 %}
                                <span class="badge bg-warning text-dark">Low Stock</span>
                            {% else %}
                                <span class="badge bg-success">In Stock</span>
                            {% endif %}
                        </td>

                        <td class="text-end">
                            <div class="d-inline-flex gap-1">

                                <a
                                    href="{{ path('app_product_edit', {'id': product.id}) }}"
                                    class="btn btn-sm btn-outline-primary"
                                    title="Edit product"
                                    aria-label="Edit {{ product.name }}"
                                >
                                    <i class="bi bi-pencil"></i>
                                </a>

                                {{ include('product/_delete_form.html.twig') }}

                            </div>
                        </td>
                    </tr>

                {% else %}
                    <tr id="emptyProductsRow">
                        <td colspan="6" class="text-center py-5">
                            <i class="bi bi-box-seam fs-1 text-secondary"></i>
                            <h5 class="mt-3">No products found</h5>
                            <p class="text-muted mb-0">
                                Add your first product to start managing inventory.
                            </p>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>

            </table>
        </div>

        <div id="noFilterResults" class="text-center py-4 text-muted" style="display: none;">
            <i class="bi bi-search fs-3"></i>
            <p class="mb-0 mt-2">No products match your filters.</p>
        </div>

        <div class="text-center py-4 text-muted border-top">
            <i class="bi bi-info-circle"></i>
            <p class="mb-0 mt-2">Product inventory management</p>
        </div>

    </section>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('productSearch');
    const categoryFilter = document.getElementById('categoryFilter');
    const stockFilter = document.getElementById('stockFilter');
    const tableBody = document.getElementById('productTableBody');
    const noResults = document.getElementById('noFilterResults');

    if (!searchInput || !categoryFilter || !stockFilter || !tableBody) {
        return;
    }

    function filterProducts() {
        const query = searchInput.value.toLowerCase().trim();
        const selectedCategory = categoryFilter.value;
        const selectedStock = stockFilter.value;
        const rows = tableBody.querySelectorAll('tr[data-stock-status]');

        let visibleCount = 0;

        rows.forEach(function (row) {
            const matchesSearch = row.textContent.toLowerCase().includes(query);

            const matchesCategory = selectedCategory === 'all'
                || row.dataset.categoryId === selectedCategory;

            const matchesStock = selectedStock === 'all'
                || row.dataset.stockStatus === selectedStock;

            const showRow = matchesSearch && matchesCategory && matchesStock;

            row.style.display = showRow ? '' : 'none';

            if (showRow) {
                visibleCount++;
            }
        });

        if (noResults) {
            noResults.style.display =
                rows.length > 0 && visibleCount === 0 ? 'block' : 'none';
        }
    }

    searchInput.addEventListener('input', filterProducts);
    categoryFilter.addEventListener('change', filterProducts);
    stockFilter.addEventListener('change', filterProducts);
});
</script>
{% endblock %}

