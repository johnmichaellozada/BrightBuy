
{% extends 'base.html.twig' %}

{% block title %}Edit Category | BrightBuy Admin{% endblock %}

{% block body %}
<div class="dashboard-container">

    <section class="welcome-section">
        <span class="dashboard-eyebrow">PRODUCT MANAGEMENT</span>
        <h1>Edit Category</h1>
        <p>Update your BrightBuy category information.</p>
    </section>

    <section class="customers-card">

        <div class="customers-header">
            <div>
                <span class="section-eyebrow">STORE ORGANIZATION</span>
                <h4>
                    <i class="bi bi-pencil-square"></i>
                    Edit Category Information
                </h4>
            </div>
        </div>

        <div class="p-4">

            {{ include('category/_form.html.twig', {
                'button_label': 'Update Category'
            }) }}

            <div class="d-flex flex-wrap gap-2 mt-4">

                <a href="{{ path('app_category_index') }}"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Back to Categories
                </a>

                <div class="ms-auto">
                    {{ include('category/_delete_form.html.twig') }}
                </div>

            </div>

        </div>

    </section>
</div>
{% endblock %}

