
{% extends 'base.html.twig' %}

{% block title %}Categories | BrightBuy Admin{% endblock %}

{% block body %}
<div class="dashboard-container">

    <section class="welcome-section">
        <span class="dashboard-eyebrow">PRODUCT MANAGEMENT</span>
        <h1>Categories</h1>
        <p>Manage your BrightBuy product categories and descriptions.</p>
    </section>

    <section class="customers-card">

        <div class="customers-header">
            <div>
                <span class="section-eyebrow">STORE ORGANIZATION</span>
                <h4>
                    <i class="bi bi-tags-fill"></i>
                    Category List
                </h4>
            </div>

            <a href="{{ path('app_category_new') }}"
               class="btn btn-warning">
                <i class="bi bi-plus-lg"></i>
                Add Category
            </a>
        </div>

        <div class="p-4 border-bottom">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-search"></i>
                </span>
                <input type="search"
                       id="categorySearch"
                       class="form-control"
                       placeholder="Search categories...">
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody id="categoryTableBody">
                {% for category in categories %}
                    <tr>
                        <td>{{ category.id }}</td>
                        <td>
                            <strong>{{ category.name }}</strong>
                        </td>
                        <td>
                            {{ category.description ?: 'No description' }}
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap gap-2 justify-content-end">

                                <a href="{{ path('app_category_show', {'id': category.id}) }}"
                                   class="btn btn-sm btn-outline-primary"
                                   title="View category">
                                    <i class="bi bi-eye"></i>
                                    <span class="d-none d-lg-inline">View</span>
                                </a>

                                <a href="{{ path('app_category_edit', {'id': category.id}) }}"
                                   class="btn btn-sm btn-outline-warning"
                                   title="Edit category">
                                    <i class="bi bi-pencil"></i>
                                    <span class="d-none d-lg-inline">Edit</span>
                                </a>

                                <form method="post"
                                      action="{{ path('app_category_delete', {'id': category.id}) }}"
                                      onsubmit="return confirm('Are you sure you want to delete this category?');"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="_token"
                                           value="{{ csrf_token('delete' ~ category.id) }}">

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Delete category">
                                        <i class="bi bi-trash"></i>
                                        <span class="d-none d-lg-inline">Delete</span>
                                    </button>
                                </form>

                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center py-5">
                            <i class="bi bi-tags fs-1 text-secondary"></i>
                            <h5 class="mt-3">No categories found</h5>
                            <p class="text-muted mb-0">
                                Add your first category to organize your products.
                            </p>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="px-4 py-3 text-muted small border-top">
            <i class="bi bi-info-circle"></i>
            Category management
        </div>

    </section>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('categorySearch');
    const tableBody = document.getElementById('categoryTableBody');

    if (!searchInput || !tableBody) {
        return;
    }

    searchInput.addEventListener('input', function () {
        const query = this.value.toLowerCase().trim();

        tableBody.querySelectorAll('tr').forEach(function (row) {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(query) ? '' : 'none';
        });
    });
});
</script>
{% endblock %}

