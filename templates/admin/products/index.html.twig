{% extends 'admin/base.html.twig' %}

{% block title %}Products | BrightBuy Admin{% endblock %}

{% block body %}

<div class="dashboard-container">

    <!-- PAGE HEADER -->
    <section class="welcome-section">
        <span class="dashboard-eyebrow">
            PRODUCT MANAGEMENT
        </span>

        <h1>
            Products
        </h1>

        <p>
            Manage your BrightBuy products, inventory, and product information.
        </p>
    </section>

    <!-- PRODUCT TOOLBAR -->
    <section class="customers-card">

        <div class="customers-header">
            <div>
                <span class="section-eyebrow">
                    STORE INVENTORY
                </span>

                <h4>
                    <i class="bi bi-box-seam-fill"></i>
                    Product List
                </h4>
            </div>

            <a href="#" class="btn btn-warning">
                <i class="bi bi-plus-lg"></i>
                Add Product
            </a>
        </div>

        <!-- SEARCH / FILTER -->
        <div class="p-4 border-bottom">

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input
                            type="text"
                            class="form-control"
                            placeholder="Search products..."
                        >
                    </div>
                </div>

                <div class="col-md-3">
                    <select class="form-select">
                        <option selected>All Categories</option>
                        <option>Electronics</option>
                        <option>Fashion</option>
                        <option>Home & Living</option>
                        <option>Sports & Outdoors</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select class="form-select">
                        <option selected>All Stock Status</option>
                        <option>In Stock</option>
                        <option>Low Stock</option>
                        <option>Out of Stock</option>
                    </select>
                </div>

            </div>

        </div>

        <!-- PRODUCT TABLE -->
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            <div class="d-flex align-items-center gap-3">

                                <div
                                    class="bg-light rounded d-flex align-items-center justify-content-center"
                                    style="width: 55px; height: 55px;"
                                >
                                    <i class="bi bi-image text-secondary fs-4"></i>
                                </div>

                                <div>
                                    <strong>Sample Product</strong>
                                    <div class="text-muted small">
                                        Product #001
                                    </div>
                                </div>

                            </div>
                        </td>

                        <td>
                            Electronics
                        </td>

                        <td>
                            ₱0.00
                        </td>

                        <td>
                            0
                        </td>

                        <td>
                            <span class="badge bg-secondary">
                                No Stock
                            </span>
                        </td>

                        <td class="text-end">

                            <button
                                type="button"
                                class="btn btn-sm btn-outline-primary"
                            >
                                <i class="bi bi-pencil"></i>
                            </button>

                            <button
                                type="button"
                                class="btn btn-sm btn-outline-danger"
                            >
                                <i class="bi bi-trash"></i>
                            </button>

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

        <!-- EMPTY / PLACEHOLDER NOTE -->
        <div class="text-center py-4 text-muted">

            <i class="bi bi-info-circle"></i>

            <p class="mb-0 mt-2">
                Product data will be connected to the BrightBuy database later.
            </p>

        </div>

    </section>

</div>

{% endblock %}