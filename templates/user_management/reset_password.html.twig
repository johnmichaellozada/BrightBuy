
{% extends 'base.html.twig' %}

{% block title %}Reset Password | BrightBuy{% endblock %}

{% block body %}

<style>
    .reset-container {
        max-width: 850px;
        margin: 0 auto;
        padding: 42px 25px 60px;
    }

    .reset-heading {
        margin-bottom: 28px;
    }

    .reset-heading h1 {
        color: #06185f;
        font-size: 32px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .reset-heading p {
        color: #71809b;
        font-size: 14px;
    }

    .reset-card {
        background: #fff;
        border-radius: 18px;
        padding: 32px;
        box-shadow: 0 8px 25px rgba(4, 24, 91, .08);
    }

    .account-summary {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px;
        background: #f5f8ff;
        border: 1px solid #e5ebf5;
        border-radius: 12px;
        margin-bottom: 28px;
    }

    .account-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e6ecfa;
        color: #1264e8;
        border: 2px solid #ffbf00;
        border-radius: 50%;
        font-size: 23px;
    }

    .account-summary h3 {
        color: #06185f;
        font-size: 16px;
        font-weight: 800;
        margin: 0 0 4px;
    }

    .account-summary p {
        color: #71809b;
        font-size: 13px;
        margin: 0;
    }

    .reset-label {
        color: #06185f;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .reset-card .form-control {
        padding: 12px 14px;
        border: 1px solid #dce3ef;
        border-radius: 9px;
        font-size: 14px;
    }

    .reset-card .form-control:focus {
        border-color: #1264e8;
        box-shadow: 0 0 0 3px rgba(18, 100, 232, .10);
    }

    .password-note {
        padding: 15px 17px;
        background: #fff9e8;
        border: 1px solid #ffe5a3;
        border-radius: 10px;
        color: #775700;
        font-size: 13px;
        line-height: 1.6;
        margin: 22px 0;
    }

    .reset-actions {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    .reset-actions .btn {
        padding: 11px 20px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
    }

    @media (max-width: 600px) {
        .reset-container {
            padding: 28px 15px 40px;
        }

        .reset-card {
            padding: 22px;
        }

        .reset-heading h1 {
            font-size: 26px;
        }

        .reset-actions {
            flex-direction: column;
        }

        .reset-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="reset-container">

    <div class="reset-heading">
        <h1>
            <i class="bi bi-shield-lock-fill me-2"></i>
            Reset Password
        </h1>
        <p>Set a new secure password for a BrightBuy account.</p>
    </div>

    <div class="reset-card">

        <div class="account-summary">
            <div class="account-icon">
                <i class="bi bi-person-fill"></i>
            </div>

            <div>
                <h3>{{ user.firstName }} {{ user.lastName }}</h3>
                <p>{{ user.email }}</p>
            </div>
        </div>

        {{ form_start(passwordForm) }}

            {{ form_errors(passwordForm) }}

            <div class="mb-4">
                {{ form_label(
                    passwordForm.plainPassword.first,
                    null,
                    {'label_attr': {'class': 'reset-label'}}
                ) }}

                {{ form_widget(
                    passwordForm.plainPassword.first,
                    {'attr': {'class': 'form-control'}}
                ) }}

                {{ form_errors(passwordForm.plainPassword.first) }}
            </div>

            <div class="mb-3">
                {{ form_label(
                    passwordForm.plainPassword.second,
                    null,
                    {'label_attr': {'class': 'reset-label'}}
                ) }}

                {{ form_widget(
                    passwordForm.plainPassword.second,
                    {'attr': {'class': 'form-control'}}
                ) }}

                {{ form_errors(passwordForm.plainPassword.second) }}
            </div>

            <div class="password-note">
                <i class="bi bi-info-circle-fill me-2"></i>
                <strong>Password requirements:</strong>
                <ul class="mb-0 mt-2">
                    <li>At least 8 characters.</li>
                    <li>Both password fields must match.</li>
                    <li>The password will be securely hashed before saving.</li>
                </ul>
            </div>

            <div class="reset-actions">

                <a href="{{ path('app_user_management') }}"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Cancel
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-shield-check me-1"></i>
                    Reset Password
                </button>

            </div>

        {{ form_end(passwordForm) }}

    </div>

</div>

{% endblock %}
