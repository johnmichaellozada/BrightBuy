
<aside class="admin-sidebar">
    <div class="sidebar-brand">
        <h2><span class="brand-bright">Bright</span><span class="brand-buy">Buy</span></h2>
    </div>

    <nav class="sidebar-nav">

        {# 1. Admin Dashboard - Admin Only #}
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_dashboard') }}"
               class="{{ app.request.attributes.get('_route') == 'app_dashboard' ? 'active' : '' }}">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </a>
        {% endif %}

        {# 2. Staff Dashboard - Staff Only #}
        {% if is_granted('ROLE_STAFF') %}
            <a href="{{ path('app_staff_dashboard') }}"
               class="{{ app.request.attributes.get('_route') == 'app_staff_dashboard' ? 'active' : '' }}">
                <i class="bi bi-speedometer2"></i>
                Staff Dashboard
            </a>
        {% endif %}

        {# 3. User Management - Admin Only #}
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_user_management') }}"
               class="{{ app.request.attributes.get('_route') starts with 'app_user_management' ? 'active' : '' }}">
                <i class="bi bi-person-gear"></i>
                User Management
            </a>
        {% endif %}

        {# 4. Inventory - Admin and Staff #}
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
            <a href="{{ path('app_inventory_index') }}"
               class="{{ app.request.attributes.get('_route') == 'app_inventory_index' ? 'active' : '' }}">
                <i class="bi bi-boxes"></i>
                Inventory
            </a>
        {% endif %}

        {# 5. Products - Admin and Staff #}
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
            <a href="{{ path('app_product_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'app_product_' ? 'active' : '' }}">
                <i class="bi bi-box-seam"></i>
                Products
            </a>
        {% endif %}

        {# 6. Categories - Admin and Staff #}
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
            <a href="{{ path('app_category_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'app_category_' ? 'active' : '' }}">
                <i class="bi bi-tags"></i>
                Categories
            </a>
        {% endif %}

        {# 7. Orders - Admin and Staff (Staff View Only) #}
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
            <a href="{{ path('app_orders') }}"
               class="{{ app.request.attributes.get('_route') starts with 'app_order' or app.request.attributes.get('_route') == 'app_orders' ? 'active' : '' }}">
                <i class="bi bi-cart-check"></i>
                Orders
            </a>
        {% endif %}

        {# 8. Customers - Admin Only #}
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_customers') }}"
               class="{{ app.request.attributes.get('_route') == 'app_customers' or app.request.attributes.get('_route') starts with 'app_customer_' ? 'active' : '' }}">
                <i class="bi bi-people"></i>
                Customers
            </a>
        {% endif %}

        {# 9. Payments - Admin Only #}
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_payments') }}"
               class="{{ app.request.attributes.get('_route') == 'app_payments' ? 'active' : '' }}">
                <i class="bi bi-credit-card"></i>
                Payments
            </a>
        {% endif %}

    </nav>
</aside>
