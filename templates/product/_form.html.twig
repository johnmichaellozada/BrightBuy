
{{ form_start(form, {
    'attr': {
        'enctype': 'multipart/form-data'
    }
}) }}

    <div class="mb-4">
        {{ form_label(form.name, 'Product Name', {
            'label_attr': {'class': 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.name, {
            'attr': {
                'class': 'form-control',
                'placeholder': 'Enter product name'
            }
        }) }}

        {{ form_errors(form.name) }}
    </div>

    <div class="mb-4">
        {{ form_label(form.category, 'Category', {
            'label_attr': {'class': 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.category, {
            'attr': {'class': 'form-select'}
        }) }}

        {{ form_errors(form.category) }}
    </div>

    <div class="mb-4">
        {{ form_label(form.image, 'Product Image', {
            'label_attr': {'class': 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.image, {
            'attr': {
                'class': 'form-control',
                'id': 'product_image_input',
                'accept': '.jpg,.jpeg,.png,.webp'
            }
        }) }}

        {{ form_errors(form.image) }}

        <small class="text-muted d-block mt-2">
            Browse and select an image from your computer.
            Accepted formats: JPG, JPEG, PNG, and WebP. Maximum size: 5 MB.
        </small>

        <div id="imagePreviewContainer" class="mt-3"
             {% if not (product is defined and product.image) %}
                 style="display: none;"
             {% endif %}>

            <p id="imagePreviewLabel" class="small fw-semibold mb-2">
                {% if product is defined and product.image %}
                    Current image:
                {% else %}
                    Image preview:
                {% endif %}
            </p>

            <img
                id="imagePreview"
                {% if product is defined and product.image %}
                    src="{{ asset(product.image) }}"
                {% endif %}
                alt="Product image preview"
                class="img-thumbnail"
                style="width: 160px; height: 160px; object-fit: contain;"
            >
        </div>
    </div>

    <div class="mb-4">
        {{ form_label(form.description, 'Description', {
            'label_attr': {'class': 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.description, {
            'attr': {
                'class': 'form-control',
                'rows': 4,
                'placeholder': 'Enter product description'
            }
        }) }}

        {{ form_errors(form.description) }}
    </div>

    <div class="mb-4">
        {{ form_label(form.price, 'Price (₱)', {
            'label_attr': {'class': 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.price, {
            'attr': {
                'class': 'form-control',
                'placeholder': '0.00',
                'min': '0',
                'step': '0.01'
            }
        }) }}

        {{ form_errors(form.price) }}
    </div>

    <button type="submit" class="btn btn-warning px-4 fw-semibold">
        <i class="bi bi-check-circle me-1"></i>
        {{ button_label|default('Save Product') }}
    </button>

{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function () {
    const imageInput = document.getElementById('product_image_input');
    const previewContainer = document.getElementById('imagePreviewContainer');
    const previewImage = document.getElementById('imagePreview');
    const previewLabel = document.getElementById('imagePreviewLabel');

    if (!imageInput || !previewContainer || !previewImage) {
        return;
    }

    imageInput.addEventListener('change', function () {
        const file = this.files[0];

        if (!file) {
            return;
        }

        const allowedTypes = [
            'image/jpeg',
            'image/png',
            'image/webp'
        ];

        if (!allowedTypes.includes(file.type)) {
            alert('Invalid image format. Please select JPG, JPEG, PNG, or WebP.');
            this.value = '';
            return;
        }

        if (file.size > 5 * 1024 * 1024) {
            alert('Image is too large. Maximum allowed size is 5 MB.');
            this.value = '';
            return;
        }

        const imageUrl = URL.createObjectURL(file);

        previewImage.src = imageUrl;
        previewContainer.style.display = 'block';
        previewLabel.textContent = 'Selected image preview:';
    });
});
</script>
