
{% extends 'base.html.twig' %}

{% block title %}Categories | BrightBuy Admin{% endblock %}

{% block body %}

<style>
    .categories-container {
        position: relative;
        isolation: isolate;
        width: 100%;
        max-width: 1350px;
        margin: auto;
        padding: 42px 30px 60px;
    }

    .categories-container::before,
    .categories-container::after {
        content: "";
        position: absolute;
        z-index: -1;
        pointer-events: none;
        border-radius: 50%;
    }

    .categories-container::before {
        width: 300px;
        height: 300px;
        top: 35px;
        right: -110px;
        border: 28px solid rgba(25, 112, 220, .07);
    }

    .categories-container::after {
        width: 230px;
        height: 230px;
        bottom: -100px;
        left: -65px;
        border: 24px solid rgba(255, 191, 0, .08);
    }

    .categories-heading {
        margin-bottom: 30px;
    }

    .categories-heading h1 {
        display: flex;
        align-items: center;
        gap: 11px;
        color: #071b55;
        font-size: 34px;
        font-weight: 800;
        letter-spacing: -.6px;
        margin: 0;
    }

    .categories-heading h1::before {
        content: "";
        width: 7px;
        height: 34px;
        flex: 0 0 7px;
        border-radius: 8px;
        background: #ffbf00;
    }

    .categories-heading p {
        color: #71809b;
        font-size: 14px;
        margin-top: 8px;
    }

    .categories-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .categories-stat-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 25px;
        background: rgba(255,255,255,.97);
        border: 1px solid rgba(255,255,255,.9);
        border-radius: 20px;
        box-shadow: 0 10px 26px rgba(8,44,105,.10);
        transition: transform .2s ease, box-shadow .2s ease;
        overflow: hidden;
    }

    .categories-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 30px rgba(8,44,105,.14);
    }

    .categories-stat-card::after {
        content: "";
        position: absolute;
        right: 0;
        bottom: 0;
        width: 58px;
        height: 19px;
        background: #ffbf00;
        clip-path: polygon(100% 0, 100% 100%, 0 100%);
    }

    .categories-stat-icon {
        width: 58px;
        height: 58px;
        min-width: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: #e6ecfa;
        color: #1264e8;
        font-size: 25px;
    }

    .categories-stat-card h2 {
        color: #06185f;
        font-size: 30px;
        font-weight: 800;
        margin: 0;
    }

    .categories-stat-card p {
        color: #71809b;
        font-size: 13px;
        margin: 4px 0 0;
    }

    .categories-panel {
        background: rgba(255,255,255,.98);
        border: 1px solid rgba(255,255,255,.9);
        border-radius: 22px;
        box-shadow: 0 10px 26px rgba(8,44,105,.10);
        overflow: hidden;
    }

    .categories-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px 28px;
        border-bottom: 1px solid #edf0f5;
        gap: 15px;
        flex-wrap: wrap;
    }

    .categories-panel-header h2 {
        color: #071b55;
        font-size: 22px;
        font-weight: 800;
        margin: 0;
    }

    .categories-panel-header h2 i {
        color: #1264e8;
    }

    .categories-panel-header p {
        color: #71809b;
        font-size: 13px;
        margin: 6px 0 0;
    }

    .categories-eyebrow {
        display: inline-block;
        color: #1264e8;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        margin-bottom: 7px;
    }

    .categories-count {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        background: #e6ecfa;
        color: #1264e8;
        font-size: 11px;
        font-weight: 700;
        margin-left: 8px;
    }

    .categories-add-btn {
        padding: 10px 17px;
        border: 1px solid #ffbf00;
        border-radius: 9px;
        background: #ffbf00;
        color: #06185f;
        font-size: 13px;
        font-weight: 700;
    }

    .categories-add-btn:hover {
        background: #e6aa00;
        border-color: #e6aa00;
        color: #06185f;
    }

    .categories-search-section {
        padding: 22px 28px;
        background: #f6f9ff;
        border-bottom: 1px solid #e6edf8;
    }

    .categories-search-section label {
        display: block;
        color: #526b91;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .categories-search-section input {
        width: 100%;
        min-height: 43px;
        padding: 10px 13px;
        border: 1px solid #dce3ef;
        border-radius: 10px;
        outline: none;
        font-family: inherit;
        font-size: 13px;
        color: #334155;
        background: #ffffff;
    }

    .categories-search-section input:focus {
        border-color: #1264e8;
        box-shadow: 0 0 0 3px rgba(18,100,232,.10);
    }

    .categories-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .categories-table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
        margin: 0;
    }

    .categories-table thead {
        background: #edf3ff;
    }

    .categories-table th {
        padding: 16px 20px;
        text-align: left;
        color: #526b91;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
    }

    .categories-table td {
        padding: 16px 20px;
        border-bottom: 1px solid #edf0f5;
        color: #263f6d;
        font-size: 13px;
        vertical-align: middle;
    }

    .categories-table tbody tr {
        transition: background .18s ease;
    }

    .categories-table tbody tr:hover {
        background: #f1f6ff;
    }

    .category-id {
        color: #71809b;
        font-weight: 700;
    }

    .category-image {
        width: 65px;
        height: 65px;
        min-width: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 1px solid #e6edf8;
        border-radius: 12px;
        background: #f6f9ff;
    }

    .category-image img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .category-image-placeholder {
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
        color: #a5b1c3;
        font-size: 25px;
    }

    .category-name {
        color: #06185f;
        font-size: 14px;
        font-weight: 700;
    }

    .category-description {
        max-width: 380px;
        color: #71809b;
        font-size: 12px;
        line-height: 1.6;
    }

    .category-actions {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: 7px;
        flex-wrap: wrap;
    }

    .category-actions .btn {
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .category-delete-form {
        display: inline-block;
        margin: 0;
    }

    .categories-empty {
        padding: 60px 20px !important;
        text-align: center;
        color: #71809b !important;
    }

    .categories-empty i {
        display: block;
        color: #a5b1c3;
        font-size: 43px;
        margin-bottom: 12px;
    }

    .categories-empty h3 {
        color: #06185f;
        font-size: 18px;
        font-weight: 800;
    }

    .categories-empty p {
        color: #71809b;
        font-size: 13px;
    }

    .categories-no-results {
        display: none;
        padding: 25px 20px;
        text-align: center;
        color: #71809b;
        font-size: 13px;
    }

    .categories-footer {
        padding: 18px 28px;
        color: #526b91;
        font-size: 12px;
        font-weight: 500;
        background: #f6f9ff;
        border-top: 1px solid #e6edf8;
    }

    @media (max-width: 900px) {
        .categories-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .categories-container {
            padding: 28px 15px 40px;
        }

        .categories-heading h1 {
            font-size: 27px;
        }

        .categories-stats {
            grid-template-columns: 1fr;
        }

        .categories-panel-header {
            padding: 20px;
        }
    }
</style>

<div class="categories-container">

    {# Page Heading #}
    <div class="categories-heading">
        <h1>Categories</h1>
        <p>Manage your BrightBuy product categories, images, and descriptions.</p>
    </div>

    {# Category Summary Card #}
    <div class="categories-stats">

        <div class="categories-stat-card">
            <div class="categories-stat-icon">
                <i class="bi bi-tags-fill"></i>
            </div>

            <div>
                <h2>{{ categories|length }}</h2>
                <p>Total Categories</p>
            </div>
        </div>

    </div>

    {# Main Categories Panel #}
    <section class="categories-panel">

        <div class="categories-panel-header">
            <div>
                <span class="categories-eyebrow">STORE ORGANIZATION</span>

                <div class="d-flex align-items-center flex-wrap">
                    <h2>
                        <i class="bi bi-tags-fill me-2"></i>
                        Category List
                    </h2>

                    <span class="categories-count">
                        {{ categories|length }} Categories
                    </span>
                </div>

                <p>Organize your products using categories and descriptions.</p>
            </div>

            {# Admin Only: Add Category #}
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_category_new') }}"
                   class="btn categories-add-btn">
                    <i class="bi bi-plus-lg me-1"></i>
                    Add Category
                </a>
            {% endif %}
        </div>

        {# Category Search #}
        <div class="categories-search-section">

            <label for="categorySearch">
                <i class="bi bi-search me-1"></i>
                Search Categories
            </label>

            <input
                type="search"
                id="categorySearch"
                placeholder="Search category name or description..."
                aria-label="Search categories"
            >

        </div>

        {# Categories Table #}
        <div class="categories-table-wrapper">

            <table class="categories-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Category Image</th>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody id="categoryTableBody">

                {% for category in categories %}

                    <tr>
                        <td>
                            <span class="category-id">
                                #{{ '%03d'|format(category.id) }}
                            </span>
                        </td>

                        <td>
                            <div class="category-image">

                                {% if category.image %}

                                    <img
                                        src="{{ asset(category.image) }}"
                                        alt="{{ category.name }}"
                                        loading="lazy"
                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                    >

                                    <div class="category-image-placeholder" style="display:none;">
                                        <i class="bi bi-image"></i>
                                    </div>

                                {% else %}

                                    <div class="category-image-placeholder">
                                        <i class="bi bi-image"></i>
                                    </div>

                                {% endif %}

                            </div>
                        </td>

                        <td>
                            <div class="category-name">
                                {{ category.name }}
                            </div>
                        </td>

                        <td>
                            <div class="category-description">
                                {{ category.description ?: 'No description available.' }}
                            </div>
                        </td>

                        <td class="text-end">

                            <div class="category-actions">

                                {# Both Admin and Staff: View #}
                                <a
                                    href="{{ path('app_category_show', {'id': category.id}) }}"
                                    class="btn btn-sm btn-outline-primary"
                                    title="View category"
                                >
                                    <i class="bi bi-eye"></i>
                                    <span class="d-none d-lg-inline">View</span>
                                </a>

                                {# Admin Only: Edit and Delete #}
                                {% if is_granted('ROLE_ADMIN') %}

                                    <a
                                        href="{{ path('app_category_edit', {'id': category.id}) }}"
                                        class="btn btn-sm btn-outline-warning"
                                        title="Edit category"
                                    >
                                        <i class="bi bi-pencil"></i>
                                        <span class="d-none d-lg-inline">Edit</span>
                                    </a>

                                    <form
                                        method="post"
                                        action="{{ path('app_category_delete', {'id': category.id}) }}"
                                        onsubmit="return confirm('Are you sure you want to delete this category?');"
                                        class="category-delete-form"
                                    >

                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('delete' ~ category.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Delete category"
                                        >
                                            <i class="bi bi-trash"></i>
                                            <span class="d-none d-lg-inline">Delete</span>
                                        </button>

                                    </form>

                                {% endif %}

                            </div>

                        </td>
                    </tr>

                {% else %}

                    <tr id="emptyCategoriesRow">
                        <td colspan="5" class="categories-empty">
                            <i class="bi bi-tags"></i>
                            <h3>No Categories Found</h3>
                            <p class="mb-0">
                                Add your first category to organize your products.
                            </p>
                        </td>
                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

        {# No Search Results #}
        <div id="categoryNoResults" class="categories-no-results">
            <i class="bi bi-search fs-3"></i>
            <p class="mb-0 mt-2">
                No categories match your search.
            </p>
        </div>

        <div class="categories-footer">
            <i class="bi bi-info-circle me-1"></i>
            Category management
            <span class="mx-2">|</span>
            Total categories: {{ categories|length }}
        </div>

    </section>

</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
    document.addEventListener('DOMContentLoaded', function () {

        const searchInput = document.getElementById('categorySearch');
        const tableBody = document.getElementById('categoryTableBody');
        const noResults = document.getElementById('categoryNoResults');

        if (!searchInput || !tableBody) {
            return;
        }

        searchInput.addEventListener('input', function () {

            const query = this.value.toLowerCase().trim();

            const rows = tableBody.querySelectorAll('tr:not(#emptyCategoriesRow)');

            let visibleCount = 0;

            rows.forEach(function (row) {

                const text = row.textContent.toLowerCase();
                const visible = text.includes(query);

                row.style.display = visible ? '' : 'none';

                if (visible) {
                    visibleCount++;
                }

            });

            if (noResults) {
                noResults.style.display =
                    rows.length > 0 && visibleCount === 0 ? 'block' : 'none';
            }

        });

    });
    </script>
{% endblock %}
