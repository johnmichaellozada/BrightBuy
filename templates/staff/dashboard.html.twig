
{% extends 'base.html.twig' %}

{% block title %}Staff Dashboard | BrightBuy{% endblock %}

{% block stylesheets %}
<style>
    .staff-dashboard {
        max-width: 1350px;
        margin: 0 auto;
        padding: 42px 30px 60px;
    }

    .staff-welcome {
        margin-bottom: 32px;
    }

    .staff-welcome h1 {
        color: #071b5c;
        font-size: 36px;
        font-weight: 800;
        margin: 0;
    }

    .staff-welcome p {
        color: #536887;
        margin-top: 8px;
        font-size: 15px;
    }

    .staff-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #e3efff;
        color: #0866df;
        border-radius: 30px;
        padding: 8px 15px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .staff-stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 35px;
    }

    .staff-stat-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 25px;
        min-height: 175px;
        box-shadow: 0 8px 20px rgba(4,24,91,0.08);
        transition: 0.2s ease;
    }

    .staff-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px rgba(4,24,91,0.12);
    }

    .staff-stat-icon {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: #e6ecfa;
        color: #1264e8;
        font-size: 24px;
        margin-bottom: 18px;
    }

    .staff-stat-card:nth-child(2) .staff-stat-icon {
        background: #fff4cc;
        color: #9a7200;
    }

    .staff-stat-card:nth-child(3) .staff-stat-icon {
        background: #ffe5e5;
        color: #dc3545;
    }

    .staff-stat-card:nth-child(4) .staff-stat-icon {
        background: #e0f5e9;
        color: #198754;
    }

    .staff-stat-card:nth-child(5) .staff-stat-icon {
        background: #eee7ff;
        color: #6f42c1;
    }

    .staff-stat-number {
        color: #071b5c;
        font-size: 32px;
        font-weight: 800;
        line-height: 1.2;
        margin: 0;
    }

    .staff-stat-label {
        color: #536887;
        font-size: 14px;
        margin-top: 7px;
    }

    .staff-section {
        margin-bottom: 32px;
    }

    .staff-section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 18px;
    }

    .staff-section-heading h2 {
        color: #071b5c;
        font-size: 23px;
        font-weight: 800;
        margin: 0;
    }

    .staff-section-heading p {
        color: #536887;
        font-size: 13px;
        margin: 5px 0 0;
    }

    .staff-quick-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .staff-quick-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px;
        background: #ffffff;
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(4,24,91,0.07);
        color: #071b5c !important;
        transition: 0.2s ease;
    }

    .staff-quick-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 25px rgba(4,24,91,0.12);
    }

    .staff-quick-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e6ecfa;
        color: #1264e8;
        border-radius: 13px;
        font-size: 21px;
    }

    .staff-quick-card h3 {
        color: #071b5c;
        font-size: 14px;
        font-weight: 700;
        margin: 0;
    }

    .staff-quick-card p {
        color: #71809b;
        font-size: 11px;
        margin: 4px 0 0;
    }

    .staff-table-card {
        background: #ffffff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(4,24,91,0.08);
    }

    .staff-table-header {
        padding: 23px 27px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .staff-table-header h3 {
        color: #071b5c;
        font-size: 19px;
        font-weight: 800;
        margin: 0;
    }

    .staff-table-header span {
        color: #1264e8;
        background: #e6ecfa;
        border-radius: 20px;
        padding: 7px 13px;
        font-size: 12px;
        font-weight: 700;
    }

    .staff-table-card .table {
        margin: 0;
        vertical-align: middle;
    }

    .staff-table-card thead th {
        background: #f6f9ff;
        color: #344b73;
        font-size: 12px;
        font-weight: 700;
        padding: 16px 22px;
        white-space: nowrap;
    }

    .staff-table-card tbody td {
        color: #344b73;
        font-size: 13px;
        padding: 16px 22px;
    }

    .staff-product-image {
        width: 45px;
        height: 45px;
        object-fit: contain;
        border-radius: 9px;
        background: #f5f7fb;
        padding: 4px;
    }

    .staff-product-name {
        color: #071b5c;
        font-weight: 700;
    }

    .staff-empty {
        padding: 55px 20px;
        text-align: center;
    }

    .staff-empty i {
        display: block;
        color: #9aabc4;
        font-size: 45px;
        margin-bottom: 12px;
    }

    .staff-empty h4 {
        color: #071b5c;
        font-size: 17px;
        font-weight: 800;
    }

    .staff-empty p {
        color: #71809b;
        font-size: 13px;
    }

    .staff-empty a {
        display: inline-block;
        background: #0866df;
        color: #ffffff !important;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        margin-top: 8px;
    }

    @media (max-width: 1000px) {
        .staff-stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .staff-quick-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 768px) {
        .staff-dashboard {
            padding: 30px 18px 45px;
        }

        .staff-welcome h1 {
            font-size: 28px;
        }

        .staff-stats-grid {
            grid-template-columns: 1fr;
        }

        .staff-quick-grid {
            grid-template-columns: 1fr;
        }

        .staff-section-heading {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>
{% endblock %}

{% block body %}

<div class="staff-dashboard">

    {# Welcome Section #}
    <section class="staff-welcome">

        <div class="staff-badge">
            <i class="bi bi-person-badge"></i>
            STAFF WORKSPACE
        </div>

        <h1>
            Welcome back, {{ staffName|default('Staff') }}!
        </h1>

        <p>
            Manage your products, monitor inventory, and view customer orders.
        </p>

    </section>


    {# Staff Statistics #}
    <section class="staff-section">

        <div class="staff-section-heading">
            <div>
                <h2>My Overview</h2>
                <p>Summary of your product and inventory activities.</p>
            </div>
        </div>

        <div class="staff-stats-grid">

            <div class="staff-stat-card">
                <div class="staff-stat-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <h3 class="staff-stat-number">
                    {{ myProductsCount }}
                </h3>

                <div class="staff-stat-label">My Products</div>
            </div>


            <div class="staff-stat-card">
                <div class="staff-stat-icon">
                    <i class="bi bi-boxes"></i>
                </div>

                <h3 class="staff-stat-number">
                    {{ myTotalStock }}
                </h3>

                <div class="staff-stat-label">Total Stock of My Products</div>
            </div>


            <div class="staff-stat-card">
                <div class="staff-stat-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <h3 class="staff-stat-number">
                    {{ myLowStock }}
                </h3>

                <div class="staff-stat-label">Low Stock Products</div>
            </div>


            <div class="staff-stat-card">
                <div class="staff-stat-icon">
                    <i class="bi bi-x-circle"></i>
                </div>

                <h3 class="staff-stat-number">
                    {{ myOutOfStock }}
                </h3>

                <div class="staff-stat-label">Out of Stock Products</div>
            </div>


            <div class="staff-stat-card">
                <div class="staff-stat-icon">
                    <i class="bi bi-cart-check"></i>
                </div>

                <h3 class="staff-stat-number">
                    {{ totalOrders }}
                </h3>

                <div class="staff-stat-label">Total Orders (View Only)</div>
            </div>

        </div>

    </section>


    {# Quick Actions #}
    <section class="staff-section">

        <div class="staff-section-heading">
            <div>
                <h2>Quick Actions</h2>
                <p>Quick access to your daily tasks.</p>
            </div>
        </div>

        <div class="staff-quick-grid">

            <a href="{{ path('app_product_index') }}" class="staff-quick-card">
                <div class="staff-quick-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <h3>Manage Products</h3>
                    <p>View and manage your products</p>
                </div>
            </a>


            <a href="{{ path('app_inventory_index') }}" class="staff-quick-card">
                <div class="staff-quick-icon">
                    <i class="bi bi-boxes"></i>
                </div>
                <div>
                    <h3>Inventory</h3>
                    <p>Monitor product stock</p>
                </div>
            </a>


            <a href="{{ path('app_orders') }}" class="staff-quick-card">
                <div class="staff-quick-icon">
                    <i class="bi bi-cart-check"></i>
                </div>
                <div>
                    <h3>View Orders</h3>
                    <p>View customer orders</p>
                </div>
            </a>


            <a href="{{ path('app_category_index') }}" class="staff-quick-card">
                <div class="staff-quick-icon">
                    <i class="bi bi-tags"></i>
                </div>
                <div>
                    <h3>Categories</h3>
                    <p>Browse product categories</p>
                </div>
            </a>

        </div>

    </section>


    {# Recent Products #}
    <section class="staff-section">

        <div class="staff-section-heading">
            <div>
                <h2>My Recent Products</h2>
                <p>Products assigned to your staff account.</p>
            </div>

            <a href="{{ path('app_product_index') }}" class="btn btn-primary btn-sm">
                View All Products
                <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>


        <div class="staff-table-card">

            <div class="staff-table-header">
                <h3>
                    <i class="bi bi-box-seam me-2"></i>
                    My Products
                </h3>

                <span>{{ myProductsCount }} Products</span>
            </div>


            {% if recentProducts is not empty %}

                <div class="table-responsive">

                    <table class="table table-hover">

                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Product Name</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            {% for product in recentProducts %}

                                {% set stock = product.stock|default(0) %}

                                <tr>

                                    <td>
                                        {% if product.image %}
                                            <img
                                                src="{{ asset(product.image) }}"
                                                alt="{{ product.name }}"
                                                class="staff-product-image"
                                            >
                                        {% else %}
                                            <div class="staff-product-image d-flex align-items-center justify-content-center">
                                                <i class="bi bi-image text-muted"></i>
                                            </div>
                                        {% endif %}
                                    </td>


                                    <td>
                                        <span class="staff-product-name">
                                            {{ product.name }}
                                        </span>
                                    </td>


                                    <td>
                                        ₱{{ product.price|number_format(2, '.', ',') }}
                                    </td>


                                    <td>
                                        {{ stock }}
                                    </td>


                                    <td>
                                        {% if stock <= 0 %}
                                            <span class="badge bg-danger">Out of Stock</span>
                                        {% elseif stock <= 5 %}
                                            <span class="badge bg-warning text-dark">Low Stock</span>
                                        {% else %}
                                            <span class="badge bg-success">In Stock</span>
                                        {% endif %}
                                    </td>

                                </tr>

                            {% endfor %}

                        </tbody>

                    </table>

                </div>

            {% else %}

                <div class="staff-empty">

                    <i class="bi bi-box-seam"></i>

                    <h4>No Products Yet</h4>

                    <p>
                        You have not created any products yet.
                    </p>

                    <a href="{{ path('app_product_index') }}">
                        <i class="bi bi-plus-circle me-1"></i>
                        Go to Products
                    </a>

                </div>

            {% endif %}

        </div>

    </section>

</div>

{% endblock %}
