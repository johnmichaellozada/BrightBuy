
{{ form_start(form) }}

    <div class="mb-4">
        {{ form_label(form.name, 'Product Name', {
            'label_attr': {'class': 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.name, {
            'attr': {
                'class': 'form-control',
                'placeholder': 'Enter product name'
            }
        }) }}

        {{ form_errors(form.name) }}
    </div>

    <div class="mb-4">
        {{ form_label(form.category, 'Category', {
            'label_attr': {'class': 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.category, {
            'attr': {'class': 'form-select'}
        }) }}

        {{ form_errors(form.category) }}
    </div>

    <div class="mb-4">
        {{ form_label(form.image, 'Product Image', {
            'label_attr': {'class': 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.image, {
            'attr': {'class': 'form-select'}
        }) }}

        {{ form_errors(form.image) }}

        <small class="text-muted">
            Select an image for this product.
        </small>

        {% if product is defined and product.image %}
            <div class="mt-3">
                <p class="small fw-semibold mb-2">Current image:</p>
                <img
                    src="{{ asset(product.image) }}"
                    alt="{{ product.name }}"
                    class="img-thumbnail"
                    style="width: 140px; height: 140px; object-fit: contain;"
                >
            </div>
        {% endif %}
    </div>

    <div class="mb-4">
        {{ form_label(form.description, 'Description', {
            'label_attr': {'class': 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.description, {
            'attr': {
                'class': 'form-control',
                'rows': 4,
                'placeholder': 'Enter product description'
            }
        }) }}

        {{ form_errors(form.description) }}
    </div>

    <div class="mb-4">
        {{ form_label(form.price, 'Price (₱)', {
            'label_attr': {'class': 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.price, {
            'attr': {
                'class': 'form-control',
                'placeholder': '0.00',
                'min': '0',
                'step': '0.01'
            }
        }) }}

        {{ form_errors(form.price) }}
    </div>

    <button type="submit" class="btn btn-warning px-4 fw-semibold">
        <i class="bi bi-check-circle me-1"></i>
        {{ button_label|default('Save Product') }}
    </button>

{{ form_end(form) }}
