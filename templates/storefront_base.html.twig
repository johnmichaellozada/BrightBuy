
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}BrightBuy | Smart Shopping. Brighter Living{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bb-navy: #071a35;
            --bb-blue: #1764b1;
            --bb-bright-blue: #2478d4;
            --bb-yellow: #ffc928;
            --bb-white: #ffffff;
            --bb-light: #f5f7fb;
            --bb-text: #26354b;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Poppins', sans-serif;
            color: var(--bb-text);
            background: var(--bb-light);
        }

        a {
            text-decoration: none;
        }

        /* Announcement bar */
        .store-topbar {
            background: var(--bb-navy);
            color: var(--bb-white);
            padding: 8px 5%;
            font-size: 12px;
            text-align: center;
        }

        .store-topbar strong {
            color: var(--bb-yellow);
        }

        /* Main header - Forced blue gradient */
        .store-header {
            background: linear-gradient(
                110deg,
                #071a35 0%,
                #123d70 55%,
                #1764b1 100%
            ) !important;
            background-color: #071a35 !important;
            color: #ffffff;
            padding: 17px 5%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            border-bottom: 1px solid rgba(255, 255, 255, .12);
            position: relative;
            z-index: 20;
        }

        .store-brand {
            color: #ffffff !important;
            font-size: 29px;
            font-weight: 800;
            letter-spacing: -1px;
            white-space: nowrap;
        }

        .store-brand span {
            color: #ffc928 !important;
        }

        /* Search bar */
        .store-search {
            flex: 1;
            max-width: 600px;
            display: flex;
            align-items: center;
            background: #f4f6fa;
            border: 1px solid #e5e9f0;
            border-radius: 8px;
            overflow: hidden;
        }

        .store-search input {
            flex: 1;
            min-width: 0;
            border: none;
            outline: none;
            background: transparent;
            padding: 12px 16px;
            font-size: 13px;
            font-family: inherit;
            color: var(--bb-navy);
        }

        .store-search input::placeholder {
            color: #718096;
        }

        .store-search button {
            border: none;
            background: var(--bb-yellow);
            color: var(--bb-navy);
            padding: 12px 20px;
            font-weight: 700;
            transition: .2s;
        }

        .store-search button:hover {
            background: #f0b900;
        }

        /* Header actions */
        .store-header-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .store-action {
            color: #ffffff !important;
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
        }

        .store-action i {
            font-size: 21px;
        }

        .store-action:hover {
            color: var(--bb-yellow) !important;
        }

        /* Admin and Staff dashboard buttons */
        .store-dashboard-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 11px 16px;
            border-radius: 8px;
            background: var(--bb-yellow);
            color: var(--bb-navy);
            font-size: 12px;
            font-weight: 800;
            white-space: nowrap;
            transition: .2s ease;
        }

        .store-dashboard-link:hover {
            background: #f0b900;
            color: var(--bb-navy);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(0, 0, 0, .15);
        }

        /* Profile icon and dropdown */
        .store-account-btn {
            border: none;
            background: transparent;
            color: #ffffff !important;
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            padding: 8px 0;
        }

        .store-account-btn:hover {
            color: var(--bb-yellow) !important;
        }

        .store-account-btn i {
            font-size: 23px;
            vertical-align: middle;
            margin-right: 5px;
        }

        .store-account-menu {
            min-width: 210px;
            border: none;
            border-radius: 10px;
            padding: 8px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, .18);
        }

        .store-account-menu .dropdown-item {
            padding: 10px 12px;
            border-radius: 6px;
            font-size: 13px;
        }

        .store-account-menu .dropdown-item:hover {
            background: #f0f5fc;
            color: var(--bb-blue);
        }

        .store-account-menu .dropdown-item i {
            width: 20px;
        }

        /* Main navigation */
        .store-navigation {
            background: var(--bb-navy);
            padding: 0 5%;
        }

        .store-navigation-inner {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 35px;
            min-height: 52px;
        }

        .store-nav-link {
            color: #ffffff;
            font-size: 12px;
            font-weight: 600;
            transition: .2s;
            white-space: nowrap;
        }

        .store-nav-link:hover,
        .store-nav-link.active {
            color: var(--bb-yellow);
        }

        .store-category-dropdown {
            color: #ffffff;
            font-size: 12px;
            font-weight: 600;
            border: none;
            background: transparent;
            padding: 0;
        }

        .store-category-dropdown:hover {
            color: var(--bb-yellow);
        }

        .store-category-menu {
            border: none;
            border-radius: 9px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .15);
            padding: 8px;
        }

        .store-category-menu .dropdown-item {
            padding: 9px 13px;
            font-size: 12px;
            border-radius: 5px;
        }

        .store-category-menu .dropdown-item:hover {
            background: #f0f5fc;
            color: var(--bb-blue);
        }

        /* Main content */
        .store-main {
            min-height: 60vh;
        }

        /* Footer */
        .store-footer {
            background: var(--bb-navy);
            color: #dce5f1;
            padding: 55px 5% 20px;
            margin-top: 50px;
        }

        .store-footer-brand {
            font-size: 27px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 12px;
        }

        .store-footer-brand span {
            color: var(--bb-yellow);
        }

        .store-footer p {
            color: #b8c7d9;
            font-size: 12px;
            line-height: 1.9;
        }

        .store-footer h5 {
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .store-footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .store-footer-links li {
            margin-bottom: 11px;
        }

        .store-footer-links a {
            color: #b8c7d9;
            font-size: 12px;
            transition: .2s;
        }

        .store-footer-links a:hover {
            color: var(--bb-yellow);
        }

        .store-footer-bottom {
            border-top: 1px solid rgba(255,255,255,.13);
            margin-top: 35px;
            padding-top: 18px;
            font-size: 11px;
            color: #aebed1;
            text-align: center;
        }

        /* Mobile navigation */
        .store-mobile-toggle {
            display: none;
            border: none;
            background: transparent;
            color: #ffffff;
            font-size: 25px;
        }

        @media (max-width: 992px) {
            .store-header {
                flex-wrap: wrap;
                gap: 15px;
            }

            .store-search {
                order: 3;
                max-width: none;
                flex-basis: 100%;
            }

            .store-header-actions {
                margin-left: auto;
            }

            .store-navigation-inner {
                gap: 20px;
                flex-wrap: wrap;
                padding: 15px 0;
            }
        }

        @media (max-width: 576px) {
            .store-topbar {
                font-size: 10px;
            }

            .store-header {
                padding: 13px 18px;
            }

            .store-brand {
                font-size: 24px;
            }

            .store-header-actions {
                gap: 13px;
            }

            .store-action span {
                display: none;
            }

            .store-action i,
            .store-account-btn i {
                font-size: 22px;
            }

            .store-dashboard-link {
                padding: 9px 10px;
                font-size: 10px;
                gap: 5px;
            }

            .store-mobile-toggle {
                display: block;
            }

            .store-navigation {
                padding: 0 18px;
            }

            .store-navigation-inner {
                display: none;
                align-items: flex-start;
                flex-direction: column;
                gap: 17px;
                padding: 18px 0;
            }

            .store-navigation-inner.show {
                display: flex;
            }

            .store-footer {
                padding: 40px 22px 20px;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>

    <!-- Announcement bar -->
    <div class="store-topbar">
        <strong>BrightBuy</strong> — Discover Quality, Shop with Confidence!
    </div>

    <!-- Main header -->
    <header class="store-header">

        <a href="{{ path('app_home') }}" class="store-brand">
            Bright<span>Buy</span>
        </a>

        <!-- Search -->
        <form class="store-search" action="/shop" method="get">
            <input
                type="search"
                name="search"
                placeholder="Search for products..."
                aria-label="Search products"
            >
            <button type="submit">
                <i class="bi bi-search"></i>
                Search
            </button>
        </form>

        <div class="store-header-actions">

            {% if is_granted('ROLE_CUSTOMER') %}
                <a href="/wishlist" class="store-action" aria-label="Wishlist">
                    <i class="bi bi-heart"></i>
                    <span>Wishlist</span>
                </a>
            {% endif %}

            <a href="/cart" class="store-action" aria-label="Shopping cart">
                <i class="bi bi-cart3"></i>
                <span>Cart</span>
            </a>

            {% if is_granted('ROLE_ADMIN') %}

                <!-- Admin dashboard -->
                <a href="{{ path('app_dashboard') }}" class="store-dashboard-link">
                    <i class="bi bi-speedometer2"></i>
                    Go to Admin Dashboard
                </a>

                <!-- Admin profile menu -->
                <div class="dropdown">
                    <button
                        class="store-account-btn dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        aria-label="Admin profile menu"
                    >
                        <i class="bi bi-person-circle"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end store-account-menu">
                        <li>
                            <a class="dropdown-item" href="{{ path('app_account_profile') }}">
                                <i class="bi bi-person"></i>
                                My Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_account_change_password') }}">
                                <i class="bi bi-shield-lock"></i>
                                Change Password
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                <i class="bi bi-box-arrow-right"></i>
                                Logout
                            </a>
                        </li>
                    </ul>
                </div>

            {% elseif is_granted('ROLE_STAFF') %}

                <!-- Staff dashboard -->
                <a href="{{ path('app_staff_dashboard') }}" class="store-dashboard-link">
                    <i class="bi bi-speedometer2"></i>
                    Go to Staff Dashboard
                </a>

                <!-- Staff profile menu -->
                <div class="dropdown">
                    <button
                        class="store-account-btn dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        aria-label="Staff profile menu"
                    >
                        <i class="bi bi-person-circle"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end store-account-menu">
                        <li>
                            <a class="dropdown-item" href="{{ path('app_account_profile') }}">
                                <i class="bi bi-person"></i>
                                My Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_account_change_password') }}">
                                <i class="bi bi-shield-lock"></i>
                                Change Password
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                <i class="bi bi-box-arrow-right"></i>
                                Logout
                            </a>
                        </li>
                    </ul>
                </div>

            {% elseif app.user %}

                <!-- Other authenticated users -->
                <div class="dropdown">
                    <button
                        class="store-account-btn dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >
                        <i class="bi bi-person-circle"></i>
                        Account
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end store-account-menu">
                        <li>
                            <a class="dropdown-item" href="{{ path('app_account_profile') }}">
                                <i class="bi bi-person"></i>
                                My Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_account_change_password') }}">
                                <i class="bi bi-shield-lock"></i>
                                Change Password
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                <i class="bi bi-box-arrow-right"></i>
                                Logout
                            </a>
                        </li>
                    </ul>
                </div>

            {% else %}

                <!-- Guest account menu -->
                <div class="dropdown">
                    <button
                        class="store-account-btn dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >
                        <i class="bi bi-person-circle"></i>
                        Account
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end store-account-menu">
                        <li>
                            <a class="dropdown-item" href="{{ path('app_login') }}">
                                <i class="bi bi-box-arrow-in-right"></i>
                                Login
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_register') }}">
                                <i class="bi bi-person-plus"></i>
                                Create Account
                            </a>
                        </li>
                    </ul>
                </div>

            {% endif %}

            <button
                class="store-mobile-toggle"
                type="button"
                aria-label="Toggle navigation"
                aria-expanded="false"
                onclick="toggleStoreNavigation(this)"
            >
                <i class="bi bi-list"></i>
            </button>

        </div>
    </header>

    <!-- Main navigation -->
    <nav class="store-navigation">
        <div class="store-navigation-inner" id="storeNavigation">

            <a href="{{ path('app_home') }}" class="store-nav-link">
                Home
            </a>

            <a href="/shop" class="store-nav-link">
                Shop
            </a>

            <div class="dropdown">
                <button
                    class="store-category-dropdown dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                >
                    Categories
                </button>

                <ul class="dropdown-menu store-category-menu">
                    {% for category in categories|default([]) %}
                        <li>
                            <a
                                class="dropdown-item"
                                href="/shop?category={{ category.id }}"
                            >
                                {{ category.name }}
                            </a>
                        </li>
                    {% else %}
                        <li>
                            <span class="dropdown-item-text text-muted">
                                No categories available
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <a href="/deals" class="store-nav-link">
                Deals
            </a>

            <a href="/new-arrivals" class="store-nav-link">
                New Arrivals
            </a>

            <a href="/track-order" class="store-nav-link">
                Track Order
            </a>

            <a href="/help" class="store-nav-link">
                Help Center
            </a>

        </div>
    </nav>

    <!-- Page content -->
    <main class="store-main">
        {% block body %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="store-footer">
        <div class="row g-4">

            <div class="col-lg-4 col-md-6">
                <div class="store-footer-brand">
                    Bright<span>Buy</span>
                </div>

                <p>
                    Smart Shopping. Brighter Living.
                    Discover quality products at prices you'll love.
                    Shop with confidence at BrightBuy.
                </p>
            </div>

            <div class="col-lg-2 col-md-6">
                <h5>Quick Links</h5>
                <ul class="store-footer-links">
                    <li><a href="{{ path('app_home') }}">Home</a></li>
                    <li><a href="/shop">Shop</a></li>
                    <li><a href="/deals">Deals</a></li>
                    <li><a href="/new-arrivals">New Arrivals</a></li>
                </ul>
            </div>

            <div class="col-lg-3 col-md-6">
                <h5>Customer Service</h5>
                <ul class="store-footer-links">
                    <li><a href="/track-order">Track Order</a></li>
                    <li><a href="/help">Help Center</a></li>
                    <li><a href="/my-orders">My Orders</a></li>
                    <li><a href="{{ path('app_account_profile') }}">My Account</a></li>
                </ul>
            </div>

            <div class="col-lg-3 col-md-6">
                <h5>My Account</h5>
                <ul class="store-footer-links">
                    <li><a href="{{ path('app_login') }}">Login</a></li>
                    <li><a href="{{ path('app_register') }}">Register</a></li>
                    <li><a href="/wishlist">Wishlist</a></li>
                    <li><a href="/cart">Shopping Cart</a></li>
                </ul>
            </div>

        </div>

        <div class="store-footer-bottom">
            &copy; {{ "now"|date("Y") }} BrightBuy. All Rights Reserved.
            Smart Shopping. Brighter Living.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function toggleStoreNavigation(button) {
            const navigation = document.getElementById('storeNavigation');
            navigation.classList.toggle('show');

            const expanded = navigation.classList.contains('show');
            button.setAttribute('aria-expanded', expanded);

            button.innerHTML = expanded
                ? '<i class="bi bi-x-lg"></i>'
                : '<i class="bi bi-list"></i>';
        }
    </script>

    {% block javascripts %}{% endblock %}

</body>
</html>
