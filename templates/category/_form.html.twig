
{{ form_start(form) }}

    <div class="mb-4">
        {{ form_label(form.name, 'Category Name', {
            'label_attr': {'class': 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.name, {
            'attr': {
                'class': 'form-control',
                'placeholder': 'Enter category name'
            }
        }) }}

        {{ form_errors(form.name) }}
    </div>

    <div class="mb-4">
        {{ form_label(form.description, 'Description', {
            'label_attr': {'class': 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.description, {
            'attr': {
                'class': 'form-control',
                'rows': 4,
                'placeholder': 'Enter category description'
            }
        }) }}

        {{ form_errors(form.description) }}
    </div>

    <div class="mb-4">
        {{ form_label(form.image, 'Category Image', {
            'label_attr': {'class': 'form-label fw-semibold'}
        }) }}

        {{ form_widget(form.image, {
            'attr': {'class': 'form-select'}
        }) }}

        {{ form_errors(form.image) }}

        {% if form.vars.data and form.vars.data.image %}
            <div class="mt-3">
                <p class="small fw-semibold mb-2">Current Image</p>
                <img
                    src="{{ asset(form.vars.data.image) }}"
                    alt="{{ form.vars.data.name }}"
                    class="img-thumbnail"
                    style="width: 120px; height: 120px; object-fit: contain;"
                >
            </div>
        {% endif %}
    </div>

    <button type="submit" class="btn btn-warning px-4 fw-semibold">
        <i class="bi bi-check-circle me-1"></i>
        {{ button_label|default('Save Category') }}
    </button>

{{ form_end(form) }}
