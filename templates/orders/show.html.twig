{% extends 'base.html.twig' %}

{% block title %}Order Details | BrightBuy Admin{% endblock %}

{% block body %}
<div class="dashboard-container">

    <section class="welcome-section">
        <span class="dashboard-eyebrow">ORDER MANAGEMENT</span>
        <h1>Order Details</h1>
        <p>Review customer information, payment, and order items.</p>
        <a href="{{ path('app_orders') }}" class="btn btn-outline-secondary mt-2">
            <i class="bi bi-arrow-left"></i> Back to Orders
        </a>
    </section>

    <section class="customers-card mb-4">
        <div class="customers-header">
            <div>
                <span class="section-eyebrow">ORDER INFORMATION</span>
                <h4><i class="bi bi-receipt"></i> #{{ order.orderNumber }}</h4>
            </div>
            {% set statusClass = {
                'Pending': 'bg-warning text-dark',
                'Processing': 'bg-primary',
                'Shipped': 'bg-info text-dark',
                'Delivered': 'bg-success',
                'Cancelled': 'bg-danger'
            } %}
            <span class="badge {{ statusClass[order.status]|default('bg-secondary') }}">
                {{ order.status }}
            </span>
        </div>

        <div class="p-4">
            <div class="row g-4">
                <div class="col-md-6">
                    <h5>Customer Information</h5>
                    <p class="mb-1"><strong>Name:</strong> {{ order.customerName }}</p>
                    <p class="mb-1"><strong>Email:</strong> {{ order.customerEmail }}</p>
                    <p class="mb-1"><strong>Phone:</strong> {{ order.customerPhone ?: 'Not provided' }}</p>
                    <p class="mb-0"><strong>Shipping Address:</strong><br>{{ order.shippingAddress|nl2br }}</p>
                </div>

                <div class="col-md-6">
                    <h5>Payment and Summary</h5>
                    <p class="mb-1"><strong>Order Date:</strong> {{ order.createdAt ? order.createdAt|date('F d, Y h:i A') : '—' }}</p>
                    <p class="mb-1">
                        <strong>Payment Status:</strong>
                        {% set paymentClass = {
                            'Pending': 'bg-secondary',
                            'Paid': 'bg-success',
                            'Failed': 'bg-danger',
                            'Refunded': 'bg-info text-dark'
                        } %}
                        <span class="badge {{ paymentClass[order.paymentStatus]|default('bg-secondary') }}">
                            {{ order.paymentStatus }}
                        </span>
                    </p>
                    <p class="fs-5 mt-3 mb-0">
                        <strong>Total:</strong> ₱{{ order.totalAmount|number_format(2, '.', ',') }}
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="customers-card">
        <div class="customers-header">
            <div>
                <span class="section-eyebrow">PURCHASE BREAKDOWN</span>
                <h4><i class="bi bi-bag-check"></i> Order Items</h4>
            </div>
            <span class="customers-count">
                {{ orderItems|length }} {{ orderItems|length == 1 ? 'item' : 'items' }}
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Unit Price</th>
                        <th>Quantity</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in orderItems %}
                        <tr>
                            <td>
                                <strong>{{ item.productName }}</strong>
                                {% if item.product is null %}
                                    <div class="text-muted small">Product record no longer available</div>
                                {% endif %}
                            </td>
                            <td>₱{{ item.unitPrice|number_format(2, '.', ',') }}</td>
                            <td>{{ item.quantity }}</td>
                            <td class="text-end">₱{{ (item.unitPrice * item.quantity)|number_format(2, '.', ',') }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <i class="bi bi-inbox fs-2 text-muted"></i>
                                <p class="mb-0 mt-2 text-muted">No items are recorded for this order.</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th colspan="3" class="text-end">Order Total</th>
                        <th class="text-end">₱{{ order.totalAmount|number_format(2, '.', ',') }}</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>

</div>
{% endblock %}