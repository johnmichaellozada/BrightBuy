
{% extends 'base.html.twig' %}

{% block title %}Customers | BrightBuy Admin{% endblock %}

{% block body %}

<style>
    .customers-container {
        position: relative;
        isolation: isolate;
        width: 100%;
        max-width: 1350px;
        margin: auto;
        padding: 42px 30px 60px;
    }

    .customers-container::before,
    .customers-container::after {
        content: "";
        position: absolute;
        z-index: -1;
        pointer-events: none;
        border-radius: 50%;
    }

    .customers-container::before {
        width: 300px;
        height: 300px;
        top: 35px;
        right: -110px;
        border: 28px solid rgba(25, 112, 220, .07);
    }

    .customers-container::after {
        width: 230px;
        height: 230px;
        bottom: -100px;
        left: -65px;
        border: 24px solid rgba(255, 191, 0, .08);
    }

    .customers-heading {
        margin-bottom: 30px;
    }

    .customers-heading h1 {
        display: flex;
        align-items: center;
        gap: 11px;
        color: #071b55;
        font-size: 34px;
        font-weight: 800;
        letter-spacing: -.6px;
        margin: 0;
    }

    .customers-heading h1::before {
        content: "";
        width: 7px;
        height: 34px;
        flex: 0 0 7px;
        border-radius: 8px;
        background: #ffbf00;
    }

    .customers-heading p {
        color: #71809b;
        font-size: 14px;
        margin-top: 8px;
    }

    .customers-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .customers-stat-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 25px;
        background: rgba(255,255,255,.97);
        border: 1px solid rgba(255,255,255,.9);
        border-radius: 20px;
        box-shadow: 0 10px 26px rgba(8,44,105,.10);
        transition: transform .2s ease, box-shadow .2s ease;
        overflow: hidden;
    }

    .customers-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 30px rgba(8,44,105,.14);
    }

    .customers-stat-card::after {
        content: "";
        position: absolute;
        right: 0;
        bottom: 0;
        width: 58px;
        height: 19px;
        background: #ffbf00;
        clip-path: polygon(100% 0, 100% 100%, 0 100%);
    }

    .customers-stat-icon {
        width: 58px;
        height: 58px;
        min-width: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: #e6ecfa;
        color: #1264e8;
        font-size: 25px;
    }

    .customers-stat-card h2 {
        color: #06185f;
        font-size: 30px;
        font-weight: 800;
        margin: 0;
    }

    .customers-stat-card p {
        color: #71809b;
        font-size: 13px;
        margin: 4px 0 0;
    }

    .customers-panel {
        background: rgba(255,255,255,.98);
        border: 1px solid rgba(255,255,255,.9);
        border-radius: 22px;
        box-shadow: 0 10px 26px rgba(8,44,105,.10);
        overflow: hidden;
    }

    .customers-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px 28px;
        border-bottom: 1px solid #edf0f5;
        gap: 15px;
        flex-wrap: wrap;
    }

    .customers-panel-header h2 {
        color: #071b55;
        font-size: 22px;
        font-weight: 800;
        margin: 0;
    }

    .customers-panel-header h2 i {
        color: #1264e8;
    }

    .customers-panel-header p {
        color: #71809b;
        font-size: 13px;
        margin: 6px 0 0;
    }

    .customers-eyebrow {
        display: inline-block;
        color: #1264e8;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        margin-bottom: 7px;
    }

    .customers-count {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        background: #e6ecfa;
        color: #1264e8;
        font-size: 11px;
        font-weight: 700;
    }

    .customers-search-section {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 15px;
        padding: 22px 28px;
        background: #f6f9ff;
        border-bottom: 1px solid #e6edf8;
    }

    .customers-search-section label {
        display: block;
        color: #526b91;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .customers-search-section input,
    .customers-search-section select {
        width: 100%;
        min-height: 43px;
        padding: 10px 13px;
        border: 1px solid #dce3ef;
        border-radius: 10px;
        outline: none;
        font-family: inherit;
        font-size: 13px;
        color: #334155;
        background: #ffffff;
    }

    .customers-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .customers-table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
        margin: 0;
    }

    .customers-table thead {
        background: #edf3ff;
    }

    .customers-table th {
        padding: 16px 20px;
        text-align: left;
        color: #526b91;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
    }

    .customers-table td {
        padding: 17px 20px;
        border-bottom: 1px solid #edf0f5;
        color: #263f6d;
        font-size: 13px;
        vertical-align: middle;
    }

    .customers-table tbody tr:hover {
        background: #f1f6ff;
    }

    .customer-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .customer-avatar {
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e6ecfa;
        color: #1264e8;
        border: 2px solid #ffbf00;
        font-size: 20px;
    }

    .customer-name {
        color: #06185f;
        font-size: 13px;
        font-weight: 700;
    }

    .customer-id {
        color: #8a96a9;
        font-size: 11px;
        margin-top: 4px;
    }

    .customer-email {
        color: #526b91;
    }

    .customer-status {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 20px;
        background: #d9f7e8;
        color: #198754;
        font-size: 11px;
        font-weight: 700;
    }

    .customer-status.disabled {
        background: #ffe1e1;
        color: #dc3545;
    }

    .customer-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 7px;
    }

    .customer-actions .btn {
        width: 35px;
        height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
    }

    .customer-actions form {
        margin: 0;
    }

    .customers-note {
        padding: 18px 28px;
        background: #f6f9ff;
        border-top: 1px solid #e6edf8;
        color: #526b91;
        font-size: 12px;
        text-align: center;
    }

    .customers-note i {
        color: #1264e8;
    }

    @media (max-width: 900px) {
        .customers-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .customers-container {
            padding: 28px 15px 40px;
        }

        .customers-heading h1 {
            font-size: 27px;
        }

        .customers-stats {
            grid-template-columns: 1fr;
        }

        .customers-search-section {
            grid-template-columns: 1fr;
        }

        .customers-panel-header {
            padding: 20px;
        }
    }
</style>

<div class="customers-container">

    <div class="customers-heading">
        <h1>Customers</h1>
        <p>Manage your BrightBuy customers and their account information.</p>
    </div>

    {# Customer Summary Cards #}
    <div class="customers-stats">

        <div class="customers-stat-card">
            <div class="customers-stat-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h2>{{ totalCustomers }}</h2>
                <p>Total Customers</p>
            </div>
        </div>

        <div class="customers-stat-card">
            <div class="customers-stat-icon" style="background:#d9f7e8;color:#198754;">
                <i class="bi bi-person-check-fill"></i>
            </div>
            <div>
                <h2>{{ activeCustomers }}</h2>
                <p>Active Customers</p>
            </div>
        </div>

        <div class="customers-stat-card">
            <div class="customers-stat-icon" style="background:#ffe1e1;color:#dc3545;">
                <i class="bi bi-person-x-fill"></i>
            </div>
            <div>
                <h2>{{ disabledCustomers }}</h2>
                <p>Disabled Customers</p>
            </div>
        </div>

    </div>

    {# Customer Management Panel #}
    <section class="customers-panel">

        <div class="customers-panel-header">
            <div>
                <span class="customers-eyebrow">REGISTERED CUSTOMERS</span>

                <h2>
                    <i class="bi bi-people-fill me-2"></i>
                    Customer List
                </h2>

                <p>View customer account information and order activity.</p>
            </div>

            <span class="customers-count">
                {{ customers|length }} Customer(s)
            </span>
        </div>

        {# Search and Status Filter #}
        <form
            method="GET"
            action="{{ path('app_customers') }}"
            class="customers-search-section"
        >

            <div>
                <label for="customerSearch">
                    <i class="bi bi-search me-1"></i>
                    Search Customers
                </label>

                <input
                    type="search"
                    id="customerSearch"
                    name="search"
                    placeholder="Search customer name or email..."
                    value="{{ search }}"
                >
            </div>

            <div>
                <label for="customerStatus">
                    <i class="bi bi-funnel me-1"></i>
                    Account Status
                </label>

                <select
                    id="customerStatus"
                    name="status"
                    onchange="this.form.submit()"
                >
                    <option value="" {{ selectedStatus == '' ? 'selected' : '' }}>
                        All Account Status
                    </option>

                    <option value="active" {{ selectedStatus == 'active' ? 'selected' : '' }}>
                        Active
                    </option>

                    <option value="disabled" {{ selectedStatus == 'disabled' ? 'selected' : '' }}>
                        Disabled
                    </option>
                </select>
            </div>

            <div style="display:flex;gap:8px;grid-column:1/-1;">
                <button
                    type="submit"
                    class="btn btn-primary fw-semibold"
                    style="border-radius:9px;"
                >
                    <i class="bi bi-search me-1"></i>
                    Search
                </button>

                <a
                    href="{{ path('app_customers') }}"
                    class="btn btn-outline-secondary"
                    style="border-radius:9px;"
                >
                    Reset
                </a>
            </div>

        </form>

        {# Customer Table #}
        <div class="customers-table-wrapper">

            {% if customers is not empty %}

                <table class="customers-table">

                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Orders</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for customer in customers %}

                            <tr>

                                <td>
                                    <div class="customer-info">

                                        <div class="customer-avatar">
                                            {{ customer.firstName|default('U')|first|upper }}{{ customer.lastName|default('')|first|upper }}
                                        </div>

                                        <div>
                                            <div class="customer-name">
                                                {{ customer.firstName }} {{ customer.lastName }}
                                            </div>

                                            <div class="customer-id">
                                                Customer #{{ '%03d'|format(customer.id) }}
                                            </div>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    <span class="customer-email">
                                        {{ customer.email }}
                                    </span>
                                </td>

                                <td>
                                    {{ customer.phone ?: 'Not provided' }}
                                </td>

                                <td>
                                    <strong>
                                        {{ customerOrderCounts[customer.id] ?? 0 }}
                                    </strong>
                                </td>

                                <td>
                                    {% if customer.isActive %}
                                        <span class="customer-status">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            Active
                                        </span>
                                    {% else %}
                                        <span class="customer-status disabled">
                                            <i class="bi bi-x-circle-fill me-1"></i>
                                            Disabled
                                        </span>
                                    {% endif %}
                                </td>

                                <td>
                                    <div class="customer-actions">

                                        {# View Customer #}
                                        <a
                                            href="{{ path('app_customer_show', {id: customer.id}) }}"
                                            class="btn btn-sm btn-outline-primary"
                                            title="View Customer"
                                            aria-label="View customer {{ customer.firstName }} {{ customer.lastName }}"
                                        >
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        {# Enable / Disable Customer #}
                                        <form
                                            method="post"
                                            action="{{ path('app_customer_toggle_status', {id: customer.id}) }}"
                                            onsubmit="return confirm('Are you sure you want to {{ customer.isActive ? 'disable' : 'enable' }} this customer account?');"
                                        >
                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('toggle_customer_status_' ~ customer.id) }}"
                                            >

                                            {% if customer.isActive %}
                                                <button
                                                    type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Disable Customer"
                                                    aria-label="Disable customer {{ customer.firstName }} {{ customer.lastName }}"
                                                >
                                                    <i class="bi bi-person-x"></i>
                                                </button>
                                            {% else %}
                                                <button
                                                    type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    title="Enable Customer"
                                                    aria-label="Enable customer {{ customer.firstName }} {{ customer.lastName }}"
                                                >
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            {% endif %}
                                        </form>

                                    </div>
                                </td>

                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            {% else %}

                <div class="text-center py-5">
                    <i
                        class="bi bi-person-exclamation"
                        style="font-size:48px;color:#a5b1c3;"
                    ></i>

                    <h3 class="mt-3" style="color:#06185f;font-weight:800;">
                        No Customers Found
                    </h3>

                    <p style="color:#71809b;font-size:13px;">
                        Try changing your search or account status filter.
                    </p>
                </div>

            {% endif %}

        </div>

        <div class="customers-note">
            <i class="bi bi-info-circle-fill me-1"></i>
            Showing {{ customers|length }} matching customer account(s).
            Order counts are based on recorded customer email addresses.
        </div>

    </section>

</div>

{% endblock %}
