
{% extends 'base.html.twig' %}

{% block title %}User Management | BrightBuy{% endblock %}

{% block body %}

<style>
    .users-container {
        position: relative;
        isolation: isolate;
        width: 100%;
        max-width: 1350px;
        margin: auto;
        padding: 42px 30px 60px;
    }

    .users-container::before,
    .users-container::after {
        content: "";
        position: absolute;
        z-index: -1;
        pointer-events: none;
        border-radius: 50%;
    }

    .users-container::before {
        width: 300px;
        height: 300px;
        top: 35px;
        right: -110px;
        border: 28px solid rgba(25, 112, 220, .07);
    }

    .users-container::after {
        width: 230px;
        height: 230px;
        bottom: -100px;
        left: -65px;
        border: 24px solid rgba(255, 191, 0, .08);
    }

    .users-heading {
        margin-bottom: 30px;
    }

    .users-heading h1 {
        display: flex;
        align-items: center;
        gap: 11px;
        color: #071b55;
        font-size: 34px;
        font-weight: 800;
        letter-spacing: -.6px;
        margin: 0;
    }

    .users-heading h1::before {
        content: "";
        width: 7px;
        height: 34px;
        flex: 0 0 7px;
        border-radius: 8px;
        background: #ffbf00;
    }

    .users-heading p {
        color: #71809b;
        font-size: 14px;
        margin-top: 8px;
    }

    .user-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .user-stat-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 25px;
        background: rgba(255,255,255,.97);
        border: 1px solid rgba(255,255,255,.9);
        border-radius: 20px;
        box-shadow: 0 10px 26px rgba(8,44,105,.10);
        transition: transform .2s ease, box-shadow .2s ease;
        overflow: hidden;
    }

    .user-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 30px rgba(8,44,105,.14);
    }

    .user-stat-card::after {
        content: "";
        position: absolute;
        right: 0;
        bottom: 0;
        width: 58px;
        height: 19px;
        background: #ffbf00;
        clip-path: polygon(100% 0, 100% 100%, 0 100%);
    }

    .user-stat-icon {
        width: 58px;
        height: 58px;
        min-width: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        font-size: 25px;
    }

    .user-stat-icon.total {
        background: #e6ecfa;
        color: #1264e8;
    }

    .user-stat-icon.active {
        background: #d9f7e8;
        color: #198754;
    }

    .user-stat-icon.disabled {
        background: #ffe1e1;
        color: #dc3545;
    }

    .user-stat-card h2 {
        color: #06185f;
        font-size: 30px;
        font-weight: 800;
        margin: 0;
    }

    .user-stat-card p {
        color: #71809b;
        font-size: 13px;
        margin: 4px 0 0;
    }

    .users-panel {
        position: relative;
        background: rgba(255,255,255,.98);
        border: 1px solid rgba(255,255,255,.9);
        border-radius: 22px;
        box-shadow: 0 10px 26px rgba(8,44,105,.10);
        overflow: hidden;
    }

    .users-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px 28px;
        border-bottom: 1px solid #edf0f5;
        gap: 15px;
        flex-wrap: wrap;
    }

    .users-panel-header h2 {
        color: #071b55;
        font-size: 22px;
        font-weight: 800;
        margin: 0;
    }

    .users-panel-header h2 i {
        color: #1264e8;
    }

    .users-count {
        background: #e6ecfa;
        color: #1264e8;
        padding: 7px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .users-filters {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr auto;
        gap: 12px;
        padding: 22px 28px;
        background: #f6f9ff;
        border-bottom: 1px solid #e6edf8;
    }

    .users-filters input,
    .users-filters select {
        width: 100%;
        min-width: 0;
        padding: 11px 13px;
        border: 1px solid #dce3ef;
        border-radius: 9px;
        outline: none;
        font-family: inherit;
        font-size: 13px;
        color: #334155;
        background: #ffffff;
    }

    .users-filters input:focus,
    .users-filters select:focus {
        border-color: #1264e8;
        box-shadow: 0 0 0 3px rgba(18,100,232,0.10);
    }

    .filter-btn {
        padding: 11px 20px;
        background: #1264e8;
        color: #ffffff;
        border: none;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }

    .filter-btn:hover {
        background: #06185f;
    }

    .reset-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 15px;
        border: 1px solid #dce3ef;
        border-radius: 9px;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
    }

    .reset-btn:hover {
        background: #f1f5f9;
        color: #06185f;
    }

    .users-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1050px;
    }

    .users-table thead {
        background: #edf3ff;
    }

    .users-table th {
        padding: 16px 20px;
        text-align: left;
        color: #71809b;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .users-table td {
        padding: 17px 20px;
        border-bottom: 1px solid #edf0f5;
        color: #334155;
        font-size: 13px;
        vertical-align: middle;
    }

    .users-table tbody tr:hover {
        background: #f1f6ff;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-avatar {
        width: 42px;
        height: 42px;
        min-width: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e6ecfa;
        color: #1264e8;
        border: 2px solid #ffbf00;
        font-weight: 800;
        font-size: 14px;
    }

    .user-name {
        color: #06185f;
        font-weight: 700;
        font-size: 13px;
    }

    .user-email {
        color: #8a96a9;
        font-size: 11px;
        margin-top: 3px;
    }

    .role-badge,
    .status-badge {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: capitalize;
        white-space: nowrap;
    }

    .role-admin {
        background: #fff1cc;
        color: #936500;
    }

    .role-staff {
        background: #e5edff;
        color: #2458b5;
    }

    .role-customer {
        background: #eee7ff;
        color: #6941a5;
    }

    .status-active {
        background: #d9f7e8;
        color: #198754;
    }

    .status-disabled {
        background: #ffe1e1;
        color: #dc3545;
    }

    .user-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .user-actions .btn {
        white-space: nowrap;
        border-radius: 8px;
    }

    .delete-form {
        display: inline-block;
        margin: 0;
    }

    .delete-btn,
    .status-btn {
        white-space: nowrap;
    }

    .status-form {
        display: inline-block;
        margin: 0;
    }

    .protected-account {
        color: #8a96a9;
        font-size: 11px;
        font-style: italic;
    }

    .empty-users {
        padding: 65px 20px;
        text-align: center;
    }

    .empty-users i {
        display: block;
        color: #a5b1c3;
        font-size: 48px;
        margin-bottom: 12px;
    }

    .empty-users h3 {
        color: #06185f;
        font-size: 19px;
        font-weight: 800;
    }

    .empty-users p {
        color: #71809b;
        font-size: 13px;
    }

    .users-footer {
        padding: 18px 28px;
        color: #526b91;
        font-size: 12px;
        font-weight: 500;
        background: #f6f9ff;
        border-top: 1px solid #e6edf8;
    }

    .users-table th {
        color: #526b91;
    }

    .users-table td {
        color: #263f6d;
    }

    .users-table tbody tr {
        transition: background .18s ease;
    }

    .users-filters input,
    .users-filters select {
        min-height: 42px;
        border-radius: 10px;
    }

    .users-filters button,
    .users-filters a,
    .users-panel-header > a {
        border-radius: 10px;
    }

    @media (max-width: 1000px) {
        .user-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .users-filters {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 600px) {
        .users-container {
            padding: 28px 15px 40px;
        }

        .users-heading h1 {
            font-size: 27px;
        }

        .user-stats {
            grid-template-columns: 1fr;
        }

        .users-filters {
            grid-template-columns: 1fr;
        }

        .users-panel-header {
            padding: 20px;
        }
    }
</style>

<div class="users-container">

    <div class="users-heading">
        <h1>User Management</h1>
        <p>Manage administrator, staff, and customer accounts in BrightBuy.</p>
    </div>

    {# Summary Cards #}
    <div class="user-stats">

        <div class="user-stat-card">
            <div class="user-stat-icon total">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h2>{{ totalUsers }}</h2>
                <p>Total Users</p>
            </div>
        </div>

        <div class="user-stat-card">
            <div class="user-stat-icon active">
                <i class="bi bi-person-check-fill"></i>
            </div>
            <div>
                <h2>{{ activeUsers }}</h2>
                <p>Active Accounts</p>
            </div>
        </div>

        <div class="user-stat-card">
            <div class="user-stat-icon disabled">
                <i class="bi bi-person-x-fill"></i>
            </div>
            <div>
                <h2>{{ inactiveUsers }}</h2>
                <p>Disabled Accounts</p>
            </div>
        </div>

    </div>

    {# User Management Table #}
    <div class="users-panel">

        <div class="users-panel-header">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <h2>
                    <i class="bi bi-people me-2"></i>
                    Registered Accounts
                </h2>

                <span class="users-count">
                    {{ users|length }} Results
                </span>
            </div>

            <a href="{{ path('app_user_management_new') }}"
               class="btn btn-primary fw-semibold">
                <i class="bi bi-person-plus-fill me-1"></i>
                Create Account
            </a>
        </div>

        {# Search and Filters #}
        <form method="GET"
              action="{{ path('app_user_management') }}"
              class="users-filters">

            <input
                type="search"
                name="search"
                placeholder="Search name or email..."
                value="{{ search }}"
            >

            <select name="role">
                <option value="">All Roles</option>
                <option value="admin" {{ selectedRole == 'admin' ? 'selected' : '' }}>Admin</option>
                <option value="staff" {{ selectedRole == 'staff' ? 'selected' : '' }}>Staff</option>
                <option value="customer" {{ selectedRole == 'customer' ? 'selected' : '' }}>Customer</option>
            </select>

            <select name="status">
                <option value="">All Statuses</option>
                <option value="active" {{ selectedStatus == 'active' ? 'selected' : '' }}>Active</option>
                <option value="disabled" {{ selectedStatus == 'disabled' ? 'selected' : '' }}>Disabled</option>
            </select>

            <div style="display:flex; gap:8px;">
                <button type="submit" class="filter-btn">
                    <i class="bi bi-search"></i> Filter
                </button>

                <a href="{{ path('app_user_management') }}" class="reset-btn">
                    Reset
                </a>
            </div>

        </form>

        {# Accounts Table #}
        <div class="users-table-wrapper">

            {% if users is not empty %}

                <table class="users-table">

                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Phone</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Date Registered</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for user in users %}

                            {% set normalizedRole = user.role|lower|replace({'role_': ''}) %}
                            {% set isCurrentUser = app.user and app.user.id == user.id %}
                            {% set isCustomer = normalizedRole == 'customer' %}
                            {% set isLastActiveAdmin = normalizedRole == 'admin' and user.isActive and activeAdmins <= 1 %}

                            <tr>

                                <td>
                                    <div class="user-info">

                                        <div class="user-avatar">
                                            {{ user.firstName|default('U')|first|upper }}{{ user.lastName|default('')|first|upper }}
                                        </div>

                                        <div>
                                            <div class="user-name">
                                                {{ user.firstName }} {{ user.lastName }}
                                            </div>

                                            <div class="user-email">
                                                {{ user.email }}
                                            </div>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    {{ user.phone ?: 'Not provided' }}
                                </td>

                                <td>
                                    <span class="role-badge role-{{ normalizedRole }}">
                                        {{ normalizedRole }}
                                    </span>
                                </td>

                                <td>
                                    {% if user.isActive %}
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Active
                                        </span>
                                    {% else %}
                                        <span class="status-badge status-disabled">
                                            <i class="bi bi-x-circle-fill"></i>
                                            Disabled
                                        </span>
                                    {% endif %}
                                </td>

                                <td>
                                    {{ user.createdAt ? user.createdAt|date('M d, Y') : 'N/A' }}
                                </td>

                                <td>
                                    <div class="user-actions">

                                        {% if isCustomer %}

                                            {# Customer: Enable / Disable only #}
                                            <form
                                                method="POST"
                                                action="{{ path('app_user_management_toggle_status', { id: user.id }) }}"
                                                class="status-form"
                                                onsubmit="return confirm('Are you sure you want to {{ user.isActive ? 'disable' : 'enable' }} the account of {{ user.firstName|e('js') }} {{ user.lastName|e('js') }}?');"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('toggle_status_' ~ user.id) }}"
                                                >

                                                {% if user.isActive %}
                                                    <button type="submit" class="btn btn-sm btn-outline-warning fw-semibold status-btn">
                                                        <i class="bi bi-person-x me-1"></i>
                                                        Disable
                                                    </button>
                                                {% else %}
                                                    <button type="submit" class="btn btn-sm btn-outline-success fw-semibold status-btn">
                                                        <i class="bi bi-person-check me-1"></i>
                                                        Enable
                                                    </button>
                                                {% endif %}
                                            </form>

                                        {% else %}

                                            {# Admin / Staff: Existing management actions #}
                                            <a href="{{ path('app_user_management_edit', { id: user.id }) }}"
                                               class="btn btn-sm btn-outline-primary fw-semibold">
                                                <i class="bi bi-pencil-square me-1"></i>
                                                Edit
                                            </a>

                                            {% if not isCurrentUser %}
                                                <a href="{{ path('app_user_management_reset_password', { id: user.id }) }}"
                                                   class="btn btn-sm btn-outline-danger fw-semibold">
                                                    <i class="bi bi-shield-lock me-1"></i>
                                                    Reset Password
                                                </a>
                                            {% endif %}

                                            {% if not isCurrentUser and not isLastActiveAdmin %}

                                                <form
                                                    method="POST"
                                                    action="{{ path('app_user_management_toggle_status', { id: user.id }) }}"
                                                    class="status-form"
                                                    onsubmit="return confirm('Are you sure you want to {{ user.isActive ? 'disable' : 'enable' }} the account of {{ user.firstName|e('js') }} {{ user.lastName|e('js') }}?');"
                                                >
                                                    <input
                                                        type="hidden"
                                                        name="_token"
                                                        value="{{ csrf_token('toggle_status_' ~ user.id) }}"
                                                    >

                                                    {% if user.isActive %}
                                                        <button type="submit" class="btn btn-sm btn-outline-warning fw-semibold status-btn">
                                                            <i class="bi bi-person-x me-1"></i>
                                                            Disable
                                                        </button>
                                                    {% else %}
                                                        <button type="submit" class="btn btn-sm btn-outline-success fw-semibold status-btn">
                                                            <i class="bi bi-person-check me-1"></i>
                                                            Enable
                                                        </button>
                                                    {% endif %}
                                                </form>

                                                <form
                                                    method="POST"
                                                    action="{{ path('app_user_management_delete', { id: user.id }) }}"
                                                    class="delete-form"
                                                    onsubmit="return confirm('Are you sure you want to permanently delete the account of {{ user.firstName|e('js') }} {{ user.lastName|e('js') }}? This action cannot be undone.');"
                                                >
                                                    <input
                                                        type="hidden"
                                                        name="_token"
                                                        value="{{ csrf_token('delete_user_' ~ user.id) }}"
                                                    >

                                                    <button
                                                        type="submit"
                                                        class="btn btn-sm btn-outline-danger fw-semibold delete-btn"
                                                    >
                                                        <i class="bi bi-trash3-fill me-1"></i>
                                                        Delete
                                                    </button>
                                                </form>

                                            {% elseif isCurrentUser %}

                                                <span class="protected-account">
                                                    Your account
                                                </span>

                                            {% elseif isLastActiveAdmin %}

                                                <span class="protected-account">
                                                    Last active Admin
                                                </span>

                                            {% endif %}

                                        {% endif %}

                                    </div>
                                </td>

                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            {% else %}

                <div class="empty-users">
                    <i class="bi bi-person-exclamation"></i>
                    <h3>No Users Found</h3>
                    <p>Try changing your search or filter options.</p>
                </div>

            {% endif %}

        </div>

        <div class="users-footer">
            Displaying {{ users|length }} account(s).
        </div>

    </div>

</div>

{% endblock %}
