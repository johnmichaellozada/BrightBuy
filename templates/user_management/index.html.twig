
{% extends 'base.html.twig' %}

{% block title %}User Management | BrightBuy{% endblock %}

{% block body %}

<style>
    .users-container {
        width: 100%;
        max-width: 1350px;
        margin: auto;
        padding: 42px 30px 60px;
    }

    .users-heading {
        margin-bottom: 30px;
    }

    .users-heading h1 {
        color: #06185f;
        font-size: 34px;
        font-weight: 800;
        margin: 0;
    }

    .users-heading p {
        color: #71809b;
        font-size: 14px;
        margin-top: 8px;
    }

    .user-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .user-stat-card {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 25px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 20px rgba(4,24,91,0.08);
    }

    .user-stat-icon {
        width: 58px;
        height: 58px;
        min-width: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        font-size: 25px;
    }

    .user-stat-icon.total {
        background: #e6ecfa;
        color: #1264e8;
    }

    .user-stat-icon.active {
        background: #d9f7e8;
        color: #198754;
    }

    .user-stat-icon.disabled {
        background: #ffe1e1;
        color: #dc3545;
    }

    .user-stat-card h2 {
        color: #06185f;
        font-size: 30px;
        font-weight: 800;
        margin: 0;
    }

    .user-stat-card p {
        color: #71809b;
        font-size: 13px;
        margin: 4px 0 0;
    }

    .users-panel {
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 8px 20px rgba(4,24,91,0.08);
        overflow: hidden;
    }

    .users-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px 28px;
        border-bottom: 1px solid #edf0f5;
    }

    .users-panel-header h2 {
        color: #06185f;
        font-size: 21px;
        font-weight: 800;
        margin: 0;
    }

    .users-count {
        background: #e6ecfa;
        color: #1264e8;
        padding: 7px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .users-filters {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr auto;
        gap: 12px;
        padding: 22px 28px;
        background: #fbfcff;
        border-bottom: 1px solid #edf0f5;
    }

    .users-filters input,
    .users-filters select {
        width: 100%;
        min-width: 0;
        padding: 11px 13px;
        border: 1px solid #dce3ef;
        border-radius: 9px;
        outline: none;
        font-family: inherit;
        font-size: 13px;
        color: #334155;
        background: #ffffff;
    }

    .users-filters input:focus,
    .users-filters select:focus {
        border-color: #1264e8;
        box-shadow: 0 0 0 3px rgba(18,100,232,0.10);
    }

    .filter-btn {
        padding: 11px 20px;
        background: #1264e8;
        color: #ffffff;
        border: none;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }

    .filter-btn:hover {
        background: #06185f;
    }

    .reset-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 15px;
        border: 1px solid #dce3ef;
        border-radius: 9px;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
    }

    .reset-btn:hover {
        background: #f1f5f9;
        color: #06185f;
    }

    .users-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 800px;
    }

    .users-table thead {
        background: #f5f8ff;
    }

    .users-table th {
        padding: 16px 20px;
        text-align: left;
        color: #71809b;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .users-table td {
        padding: 17px 20px;
        border-bottom: 1px solid #edf0f5;
        color: #334155;
        font-size: 13px;
        vertical-align: middle;
    }

    .users-table tbody tr:hover {
        background: #f8faff;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-avatar {
        width: 42px;
        height: 42px;
        min-width: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e6ecfa;
        color: #1264e8;
        border: 2px solid #ffbf00;
        font-weight: 800;
        font-size: 14px;
    }

    .user-name {
        color: #06185f;
        font-weight: 700;
        font-size: 13px;
    }

    .user-email {
        color: #8a96a9;
        font-size: 11px;
        margin-top: 3px;
    }

    .role-badge,
    .status-badge {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: capitalize;
        white-space: nowrap;
    }

    .role-admin {
        background: #fff1cc;
        color: #936500;
    }

    .role-staff {
        background: #e5edff;
        color: #2458b5;
    }

    .role-customer {
        background: #eee7ff;
        color: #6941a5;
    }

    .status-active {
        background: #d9f7e8;
        color: #198754;
    }

    .status-disabled {
        background: #ffe1e1;
        color: #dc3545;
    }

    .empty-users {
        padding: 65px 20px;
        text-align: center;
    }

    .empty-users i {
        display: block;
        color: #a5b1c3;
        font-size: 48px;
        margin-bottom: 12px;
    }

    .empty-users h3 {
        color: #06185f;
        font-size: 19px;
        font-weight: 800;
    }

    .empty-users p {
        color: #71809b;
        font-size: 13px;
    }

    .users-footer {
        padding: 18px 28px;
        color: #71809b;
        font-size: 12px;
        background: #fbfcff;
    }

    @media (max-width: 1000px) {
        .user-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .users-filters {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 600px) {
        .users-container {
            padding: 28px 15px 40px;
        }

        .users-heading h1 {
            font-size: 27px;
        }

        .user-stats {
            grid-template-columns: 1fr;
        }

        .users-filters {
            grid-template-columns: 1fr;
        }

        .users-panel-header {
            padding: 20px;
        }
    }
</style>

<div class="users-container">

    {# Page Heading #}
    <div class="users-heading">
        <h1>User Management</h1>
        <p>Manage administrator, staff, and customer accounts in BrightBuy.</p>
    </div>

    {# Summary Cards #}
    <div class="user-stats">

        <div class="user-stat-card">
            <div class="user-stat-icon total">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h2>{{ totalUsers }}</h2>
                <p>Total Users</p>
            </div>
        </div>

        <div class="user-stat-card">
            <div class="user-stat-icon active">
                <i class="bi bi-person-check-fill"></i>
            </div>
            <div>
                <h2>{{ activeUsers }}</h2>
                <p>Active Accounts</p>
            </div>
        </div>

        <div class="user-stat-card">
            <div class="user-stat-icon disabled">
                <i class="bi bi-person-x-fill"></i>
            </div>
            <div>
                <h2>{{ inactiveUsers }}</h2>
                <p>Disabled Accounts</p>
            </div>
        </div>

    </div>

    {# User Management Table #}
    <div class="users-panel">

        <div class="users-panel-header">
            <h2>
                <i class="bi bi-people me-2"></i>
                Registered Accounts
            </h2>

            <span class="users-count">
                {{ users|length }} Results
            </span>
        </div>

        {# Search and Filters #}
        <form method="GET"
              action="{{ path('app_user_management') }}"
              class="users-filters">

            <input
                type="search"
                name="search"
                placeholder="Search name or email..."
                value="{{ search }}"
            >

            <select name="role">
                <option value="">All Roles</option>
                <option value="admin" {{ selectedRole == 'admin' ? 'selected' : '' }}>Admin</option>
                <option value="staff" {{ selectedRole == 'staff' ? 'selected' : '' }}>Staff</option>
                <option value="customer" {{ selectedRole == 'customer' ? 'selected' : '' }}>Customer</option>
            </select>

            <select name="status">
                <option value="">All Statuses</option>
                <option value="active" {{ selectedStatus == 'active' ? 'selected' : '' }}>Active</option>
                <option value="disabled" {{ selectedStatus == 'disabled' ? 'selected' : '' }}>Disabled</option>
            </select>

            <div style="display:flex; gap:8px;">
                <button type="submit" class="filter-btn">
                    <i class="bi bi-search"></i> Filter
                </button>

                <a href="{{ path('app_user_management') }}" class="reset-btn">
                    Reset
                </a>
            </div>

        </form>

        {# Accounts Table #}
        <div class="users-table-wrapper">

            {% if users is not empty %}

                <table class="users-table">

                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Phone</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Date Registered</th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for user in users %}

                            <tr>
                                <td>
                                    <div class="user-info">

                                        <div class="user-avatar">
                                            {{ user.firstName|default('U')|first|upper }}{{ user.lastName|default('')|first|upper }}
                                        </div>

                                        <div>
                                            <div class="user-name">
                                                {{ user.firstName }} {{ user.lastName }}
                                            </div>

                                            <div class="user-email">
                                                {{ user.email }}
                                            </div>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    {{ user.phone ?: 'Not provided' }}
                                </td>

                                <td>
                                    {% set normalizedRole = user.role|lower|replace({'role_': ''}) %}

                                    <span class="role-badge role-{{ normalizedRole }}">
                                        {{ normalizedRole }}
                                    </span>
                                </td>

                                <td>
                                    {% if user.isActive %}
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Active
                                        </span>
                                    {% else %}
                                        <span class="status-badge status-disabled">
                                            <i class="bi bi-x-circle-fill"></i>
                                            Disabled
                                        </span>
                                    {% endif %}
                                </td>

                                <td>
                                    {{ user.createdAt ? user.createdAt|date('M d, Y') : 'N/A' }}
                                </td>
                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            {% else %}

                <div class="empty-users">
                    <i class="bi bi-person-exclamation"></i>
                    <h3>No Users Found</h3>
                    <p>Try changing your search or filter options.</p>
                </div>

            {% endif %}

        </div>

        <div class="users-footer">
            Displaying {{ users|length }} account(s).
        </div>

    </div>

</div>

{% endblock %}
